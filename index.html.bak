<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#f431cb">

  <link rel="icon" href="swimtrain-favicon.ico" type="image/x-icon">

  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">

  <title>Swimming Lessons Hemel Hempstead | Swimtrain</title>
  <meta name="description" content="Personalised swimming lessons in Hemel Hempstead with Swimtrain. Small classes, sibling, 1-to-1 and parent & baby lessons in a private 32°C heated pool in Boxmoor.">
  <link rel="canonical" href="https://swimtrain.co.uk/">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_GB">
  <meta property="og:site_name" content="Swimtrain">
  <meta property="og:title" content="Swimming Lessons Hemel Hempstead | Swimtrain">
  <meta property="og:description" content="Small, personalised swimming lessons in a private 32°C heated pool in Boxmoor, Hemel Hempstead.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@graph":[
      {
        "@type":["LocalBusiness","SportsActivityLocation"],
        "@id":"https://swimtrain.co.uk/#business",
        "name":"Swimtrain",
        "url":"https://swimtrain.co.uk/",
        "email":"swimtrainuk@gmail.com",
        "telephone":"+447364123477",
        "sameAs":["https://www.facebook.com/profile.php?id=61557103169004"],
        "description":"Personalised swimming lessons in Hemel Hempstead including small classes, sibling lessons, 1-to-1 swimming lessons and parent & baby classes in a private 32°C heated pool.",
        "address":{
          "@type":"PostalAddress",
          "addressLocality":"Boxmoor",
          "addressRegion":"Hertfordshire",
          "postalCode":"HP1 1RP",
          "addressCountry":"GB"
        },
        "areaServed":[
          {"@type":"City","name":"Hemel Hempstead"},
          {"@type":"Place","name":"Boxmoor"}
        ]
      },
      {
        "@type":"FAQPage",
        "@id":"https://swimtrain.co.uk/#faq",
        "mainEntity":[
          {"@type":"Question","name":"Where are Swimtrain lessons held?","acceptedAnswer":{"@type":"Answer","text":"Swimtrain lessons are held in a private heated pool in Boxmoor, Hemel Hempstead."}},
          {"@type":"Question","name":"What swimming lessons does Swimtrain offer?","acceptedAnswer":{"@type":"Answer","text":"Swimtrain offers small classes, sibling lessons, 1-to-1 swimming lessons and parent & baby classes."}},
          {"@type":"Question","name":"How warm is the pool?","acceptedAnswer":{"@type":"Answer","text":"The private Swimtrain pool is heated to approximately 32°C."}},
          {"@type":"Question","name":"Can parents track progress online?","acceptedAnswer":{"@type":"Answer","text":"Yes. Swimtrain has an online parent portal where parents can follow progress, book in and out of classes, manage monthly subscription payments and receive certificates."}}
        ]
      }
    ]
  }
  </script>

  <style>
    :root{
      --pink:#f431cb;
      --pink-deep:#c916a7;
      --pink-light:#ff85e5;
      --pink-pale:#fff2fb;
      --aqua:#55d5df;
      --aqua-dark:#109caf;
      --aqua-pale:#eaffff;
      --blue:#0baad2;
      --ink:#10131c;
      --ink-2:#1b2030;
      --muted:#697080;
      --white:#fff;
      --line:rgba(16,19,28,.10);
      --glass:rgba(255,255,255,.72);
      --shadow:0 30px 80px rgba(27,16,29,.14);
      --wrap:min(1200px,calc(100% - 40px));
      --water-shift:0px;
      --thermo-progress:0;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      overflow-x:hidden;
      color:var(--ink);
      background:#fff;
      font-family:"Poppins",system-ui,sans-serif;
      -webkit-font-smoothing:antialiased;
    }
    a{color:inherit;text-decoration:none}
    img{display:block;max-width:100%}
    button{font:inherit}
    .wrap{width:var(--wrap);margin:auto}
    .section{position:relative;padding:110px 0}
    .soft{background:#fffafd}
    .dark{background:#111628;color:#fff}
    .pink{color:var(--pink)}

    /* ---------- FLOATING WATER BACKGROUND ---------- */
    .water-field{
      position:fixed;
      inset:0;
      z-index:-1;
      pointer-events:none;
      overflow:hidden;
      opacity:.8;
    }
    .water-field::before,
    .water-field::after{
      content:"";
      position:absolute;
      width:680px;height:680px;
      border-radius:46% 54% 52% 48% / 52% 42% 58% 48%;
      filter:blur(1px);
      transform:translateY(var(--water-shift));
    }
    .water-field::before{
      top:9%;right:-360px;
      border:1px solid rgba(85,213,223,.17);
      box-shadow:
        0 0 0 55px rgba(85,213,223,.04),
        0 0 0 112px rgba(244,49,203,.025);
      animation:waterRotate 20s linear infinite;
    }
    .water-field::after{
      top:58%;left:-430px;
      border:1px solid rgba(244,49,203,.11);
      box-shadow:0 0 0 70px rgba(85,213,223,.035);
      animation:waterRotate 28s linear infinite reverse;
    }
    @keyframes waterRotate{to{rotate:360deg}}

    /* ---------- HEADER ---------- */
    .header{
      position:fixed;
      z-index:100;
      inset:0 0 auto;
      padding:12px 0;
      transition:.3s ease;
    }
    .header.scrolled{padding:7px 0}
    .nav{
      width:var(--wrap);
      margin:auto;
      min-height:70px;
      padding:7px 9px 7px 12px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:20px;
      border:1px solid rgba(255,255,255,.66);
      border-radius:999px;
      background:rgba(255,255,255,.76);
      backdrop-filter:blur(20px);
      box-shadow:0 14px 42px rgba(43,20,39,.09);
    }
    .header.scrolled .nav{
      background:rgba(255,255,255,.93);
      border-color:var(--line);
    }
    .brand{display:flex;align-items:center;gap:9px}
    .brand img{
      width:50px;height:50px;
      object-fit:contain;border-radius:50%;background:#fff;
    }
    .brand strong{font-size:19px;letter-spacing:-.04em}
    .nav-links{display:flex;align-items:center;gap:24px}
    .nav-links a{color:#4d5360;font-size:12px;font-weight:600}
    .nav-links a:hover{color:var(--pink)}
    .nav-actions{display:flex;align-items:center;gap:7px}
    .portal-link{padding:11px 12px;color:#4d5360;font-size:11px;font-weight:700}
    .btn{
      min-height:48px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
      padding:0 20px;
      border:1px solid transparent;
      border-radius:999px;
      font-size:12px;
      font-weight:700;
      transition:.22s ease;
    }
    .btn:hover{transform:translateY(-2px)}
    .btn-pink{background:var(--pink);color:#fff;box-shadow:0 13px 32px rgba(244,49,203,.25)}
    .btn-white{background:#fff;border-color:var(--line);color:var(--ink)}
    .btn-glass{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.16);color:#fff}
    .menu{
      display:none;width:46px;height:46px;border:0;border-radius:50%;background:var(--ink);cursor:pointer
    }
    .menu span{display:block;width:18px;height:2px;margin:4px auto;background:#fff;border-radius:99px}

    /* ---------- HERO ---------- */
    .hero{
      position:relative;
      min-height:850px;
      padding:145px 0 105px;
      display:flex;
      align-items:center;
      overflow:hidden;
      background:
        radial-gradient(circle at 83% 22%,rgba(85,213,223,.19),transparent 27rem),
        radial-gradient(circle at 8% 18%,rgba(244,49,203,.14),transparent 26rem),
        linear-gradient(180deg,#fff 0%,#fff8fd 100%);
    }
    .hero-dots{
      position:absolute;inset:0;opacity:.19;pointer-events:none;
      background-image:radial-gradient(rgba(16,19,28,.18) 1px,transparent 1px);
      background-size:31px 31px;
      mask-image:linear-gradient(#000,transparent 92%);
    }
    .hero-grid{
      position:relative;z-index:4;
      width:var(--wrap);margin:auto;
      display:grid;grid-template-columns:1.02fr .98fr;
      gap:65px;align-items:center;
    }
    .eyebrow,.kicker{
      display:inline-flex;align-items:center;gap:9px;
      color:var(--pink-deep);
      font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;
    }
    .eyebrow{
      padding:9px 12px;border-radius:999px;
      border:1px solid rgba(244,49,203,.15);
      background:rgba(255,255,255,.76);
    }
    .eyebrow::before,.kicker::before{
      content:"";width:7px;height:7px;border-radius:50%;
      background:var(--pink);
      box-shadow:0 0 0 5px rgba(244,49,203,.09);
    }
    h1{
      max-width:760px;
      margin:18px 0 22px;
      color:var(--ink);
      font-size:clamp(56px,6.8vw,98px);
      line-height:.89;
      letter-spacing:-.076em;
      font-weight:800;
    }
    .outline-text{
      color:transparent;
      -webkit-text-stroke:1.7px rgba(16,19,28,.73);
    }
    .lead{
      max-width:650px;margin:0;
      color:var(--muted);font-size:16px;line-height:1.76;
    }
    .hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
    .micro{
      display:flex;flex-wrap:wrap;gap:14px 23px;margin-top:27px;
      color:#515765;font-size:11px;font-weight:600;
    }
    .micro span{display:flex;align-items:center;gap:7px}
    .micro b{
      width:19px;height:19px;display:grid;place-items:center;border-radius:50%;
      color:#fff;background:var(--pink);font-size:10px;
    }

    .hero-visual{position:relative;min-height:570px}
    .hero-photo{
      position:absolute;inset:10px 0 25px 38px;
      overflow:hidden;
      border-radius:46px 46px 130px 46px;
      box-shadow:0 34px 90px rgba(14,75,92,.23);
      background:#49c8df;
    }
    .hero-photo img{
      width:100%;height:100%;object-fit:cover;
      object-position:50% 36%;
      transform:scale(1.02);
      transition:transform .2s linear;
    }
    .hero-photo::after{
      content:"";position:absolute;inset:0;
      background:linear-gradient(180deg,transparent 50%,rgba(8,35,54,.18));
      pointer-events:none;
    }

    /* Water lens over hero image */
    .water-lens{
      position:absolute;
      z-index:4;
      left:8px;bottom:-5px;
      width:210px;height:210px;
      border-radius:50%;
      border:1px solid rgba(255,255,255,.56);
      background:rgba(85,213,223,.11);
      backdrop-filter:blur(3px);
      box-shadow:
        inset 0 0 40px rgba(255,255,255,.22),
        0 22px 60px rgba(17,100,121,.16);
      animation:lensFloat 6s ease-in-out infinite alternate;
    }
    .water-lens::before,.water-lens::after{
      content:"";position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,.42);
    }
    .water-lens::before{inset:23px}
    .water-lens::after{inset:53px}
    @keyframes lensFloat{to{transform:translateY(-16px) rotate(5deg)}}

    .hero-bubble{
      position:absolute;z-index:5;border-radius:50%;
      border:1px solid rgba(255,255,255,.63);
      background:rgba(255,255,255,.13);
      backdrop-filter:blur(2px);
      box-shadow:inset 5px 5px 13px rgba(255,255,255,.22);
      animation:bubble 5s ease-in-out infinite alternate;
    }
    .bubble-a{width:50px;height:50px;right:-6px;top:50px}
    .bubble-b{width:28px;height:28px;right:24px;top:128px;animation-delay:-2s}
    .bubble-c{width:18px;height:18px;left:8px;top:70px;animation-delay:-3s}
    @keyframes bubble{to{transform:translateY(-22px) translateX(6px)}}

    .hero-badge{
      position:absolute;z-index:8;
      right:-8px;bottom:49px;
      width:190px;padding:18px;
      border:1px solid rgba(16,19,28,.08);
      border-radius:22px;
      background:rgba(255,255,255,.91);
      backdrop-filter:blur(18px);
      box-shadow:0 20px 55px rgba(15,44,53,.16);
    }
    .hero-badge small{
      display:block;color:var(--pink);font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
    }
    .hero-badge strong{
      display:block;margin-top:6px;font-size:16px;line-height:1.3;
    }

    /* Hero waterline */
    .hero-waterline{
      position:absolute;z-index:2;
      left:-5%;right:-5%;bottom:-85px;height:175px;
      background:linear-gradient(180deg,rgba(85,213,223,.16),rgba(85,213,223,.035));
      border-radius:45% 55% 0 0 / 26% 38% 0 0;
      animation:waveFloat 8s ease-in-out infinite alternate;
    }
    .hero-waterline::before{
      content:"";position:absolute;left:8%;right:8%;top:-24px;height:80px;
      border-top:2px solid rgba(85,213,223,.22);
      border-radius:50%;
      transform:translateX(calc(var(--water-shift) * .05));
    }
    @keyframes waveFloat{to{transform:translateY(-11px) scaleX(1.04)}}

    /* ---------- TRUST BAND ---------- */
    .trust-wrap{position:relative;z-index:10;margin-top:-26px}
    .trust-grid{
      width:var(--wrap);margin:auto;
      display:grid;grid-template-columns:repeat(6,minmax(0,1fr));
      overflow:hidden;border:1px solid var(--line);border-radius:27px;
      background:rgba(255,255,255,.94);backdrop-filter:blur(18px);
      box-shadow:0 18px 60px rgba(16,19,28,.08);
    }
    .trust{
      min-height:108px;padding:20px 14px;
      display:grid;place-items:center;align-content:center;text-align:center;
      border-right:1px solid var(--line);
    }
    .trust:last-child{border-right:0}
    .trust i{
      width:8px;height:8px;margin-bottom:10px;border-radius:50%;
      background:var(--pink);box-shadow:0 0 0 6px rgba(244,49,203,.08);
    }
    .trust strong{font-size:12px}
    .trust small{margin-top:5px;color:var(--muted);font-size:9px;line-height:1.4}

    /* ---------- HEADINGS ---------- */
    .section-heading{max-width:800px;margin-bottom:46px}
    .section-heading.center{margin-inline:auto;text-align:center}
    h2{
      margin:12px 0 17px;
      color:var(--ink);
      font-size:clamp(42px,5.5vw,73px);
      line-height:.95;
      letter-spacing:-.064em;
      font-weight:800;
    }
    .dark h2{color:#fff}
    .body,.section-heading p{
      margin:0;color:var(--muted);font-size:14px;line-height:1.78;
    }
    .dark .body,.dark .section-heading p{color:rgba(255,255,255,.67)}

    /* ---------- LESSONS ---------- */
    .lesson-list{border-top:1px solid var(--line)}
    .lesson-row{
      display:grid;
      grid-template-columns:120px 1fr 1fr 44px;
      gap:22px;align-items:center;
      padding:31px 7px;border-bottom:1px solid var(--line);
      transition:.28s ease;
    }
    .lesson-row:hover{
      padding-left:17px;
      background:linear-gradient(90deg,rgba(244,49,203,.055),transparent 72%);
    }
    .lesson-no{
      color:transparent;-webkit-text-stroke:1.25px rgba(244,49,203,.67);
      font-size:55px;font-weight:800;line-height:.9;letter-spacing:-.07em;
    }
    .lesson-row h3{
      margin:0;color:var(--ink);
      font-size:clamp(22px,2.5vw,34px);line-height:1.05;letter-spacing:-.045em;
    }
    .lesson-row p{margin:0;color:var(--muted);font-size:12px;line-height:1.65}
    .arrow{
      width:38px;height:38px;display:grid;place-items:center;border-radius:50%;
      border:1px solid var(--line);color:var(--pink);transition:.25s ease;
    }
    .lesson-row:hover .arrow{background:var(--pink);color:#fff;transform:rotate(-45deg)}

    /* ---------- MARQUEE ---------- */
    .marquee{overflow:hidden;padding:24px 0;background:var(--pink)}
    .marquee-track{
      width:max-content;display:flex;align-items:center;
      animation:marquee 43s linear infinite;will-change:transform;
    }
    .marquee-item{
      white-space:nowrap;padding:0 29px;
      color:#fff;font-size:clamp(30px,4vw,58px);line-height:1;font-weight:800;
      letter-spacing:-.055em;text-transform:uppercase;
    }
    .marquee-item:nth-child(even){color:transparent;-webkit-text-stroke:1.25px rgba(255,255,255,.78)}
    .marquee-item::after{content:"•";display:inline-block;margin-left:56px;color:#fff;-webkit-text-stroke:0}
    @keyframes marquee{to{transform:translateX(-50%)}}

    /* ---------- WHY / PHOTO ---------- */
    .why-grid{
      display:grid;grid-template-columns:.96fr 1.04fr;gap:75px;align-items:center;
    }
    .why-photo{
      position:relative;min-height:620px;overflow:hidden;
      border-radius:45px 45px 120px 45px;
      box-shadow:var(--shadow);
      background:#09acd0;
    }
    .why-photo img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
    .why-photo::after{
      content:"";position:absolute;inset:0;
      background:linear-gradient(180deg,transparent 54%,rgba(8,31,43,.23));
    }
    .ripple-stack{
      position:absolute;z-index:4;right:-57px;top:42px;width:190px;height:190px;
    }
    .ripple-stack i{
      position:absolute;inset:50%;border-radius:50%;
      border:1px solid rgba(255,255,255,.7);
      animation:ripple 3.2s ease-out infinite;
    }
    .ripple-stack i:nth-child(2){animation-delay:1.05s}
    .ripple-stack i:nth-child(3){animation-delay:2.1s}
    @keyframes ripple{
      from{inset:48%;opacity:.8}
      to{inset:0;opacity:0}
    }
    .benefits{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-top:27px}
    .benefit{
      padding:18px;border:1px solid var(--line);border-radius:18px;background:#fff;
    }
    .benefit b{
      width:30px;height:30px;display:grid;place-items:center;margin-bottom:14px;
      border-radius:50%;background:var(--pink);color:#fff;font-size:10px;
    }
    .benefit strong{display:block;font-size:12px}
    .benefit span{display:block;margin-top:5px;color:var(--muted);font-size:10px;line-height:1.55}

    /* ---------- THERMOMETER / POOL ---------- */
    .pool-section{
      overflow:hidden;
      background:
        linear-gradient(180deg,#effdff 0%,#fff 65%),
        #fff;
    }
    .pool-section::before{
      content:"";position:absolute;left:-10%;right:-10%;top:-75px;height:135px;
      border-radius:0 0 50% 50% / 0 0 100% 100%;
      background:#fff;
      box-shadow:0 28px 0 rgba(85,213,223,.05);
    }
    .pool-grid{
      display:grid;grid-template-columns:1.1fr .9fr;gap:65px;align-items:center;
    }
    .pool-photo{
      position:relative;min-height:560px;overflow:hidden;
      border-radius:36px;box-shadow:0 28px 75px rgba(21,75,86,.16);
    }
    .pool-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .pool-photo::after{
      content:"";position:absolute;inset:0;
      background:linear-gradient(180deg,transparent 65%,rgba(3,68,87,.16));
    }

    .temperature-stage{
      position:relative;
      display:grid;grid-template-columns:135px 1fr;gap:28px;align-items:center;
      margin:18px 0 22px;
    }
    .thermometer{
      position:relative;
      width:93px;height:310px;
      margin:auto;
      filter:drop-shadow(0 18px 25px rgba(0,120,144,.13));
    }
    .thermo-shell{
      position:absolute;left:27px;top:0;width:39px;height:248px;border-radius:999px;
      border:5px solid var(--ink);
      background:#fff;
      overflow:hidden;
    }
    .thermo-fill{
      position:absolute;left:8px;right:8px;bottom:7px;height:calc(16% + (var(--thermo-progress) * 70%));
      border-radius:999px;
      background:linear-gradient(180deg,var(--pink-light),var(--pink));
      transition:height .08s linear;
    }
    .thermo-bulb{
      position:absolute;left:9px;bottom:0;width:75px;height:75px;border-radius:50%;
      border:5px solid var(--ink);background:#fff;
    }
    .thermo-bulb::after{
      content:"";position:absolute;inset:11px;border-radius:50%;
      background:var(--pink);transform:scale(calc(.72 + (var(--thermo-progress) * .28)));
      transition:transform .08s linear;
    }
    .thermo-lines{
      position:absolute;right:0;top:35px;width:34px;height:175px;
      background:repeating-linear-gradient(to bottom,var(--ink) 0 2px,transparent 2px 23px);
      opacity:.4;
      clip-path:polygon(52% 0,100% 0,100% 100%,52% 100%);
    }
    .temp-copy strong{
      display:block;color:var(--pink);
      font-size:clamp(78px,9vw,130px);line-height:.77;letter-spacing:-.09em;
    }
    .temp-copy span{
      display:block;margin-top:14px;color:var(--ink);font-size:15px;font-weight:700;
    }
    .temp-copy small{
      display:block;margin-top:6px;color:var(--muted);font-size:10px;line-height:1.55;
    }
    .pool-points{display:grid;gap:11px}
    .pool-point{
      display:flex;gap:12px;align-items:flex-start;
      padding:14px 0;border-bottom:1px solid var(--line);
    }
    .pool-point:last-child{border-bottom:0}
    .pool-point i{
      width:28px;height:28px;flex:0 0 28px;display:grid;place-items:center;border-radius:50%;
      background:var(--aqua-pale);color:var(--aqua-dark);font-style:normal;font-size:11px;font-weight:800;
    }
    .pool-point strong{display:block;font-size:12px}
    .pool-point span{display:block;margin-top:3px;color:var(--muted);font-size:10px;line-height:1.5}

    /* ---------- QUALIFICATIONS ---------- */
    .qual-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:38px}
    .qual{
      min-height:215px;padding:23px;display:flex;flex-direction:column;justify-content:space-between;
      border:1px solid rgba(255,255,255,.1);border-radius:24px;
      background:rgba(255,255,255,.05);transition:.25s ease;
    }
    .qual:hover{transform:translateY(-5px);background:rgba(255,255,255,.075)}
    .qual-no{
      color:transparent;-webkit-text-stroke:1px rgba(244,49,203,.78);
      font-size:45px;font-weight:800;line-height:1;
    }
    .qual strong{color:#fff;font-size:15px;line-height:1.32}

    /* ---------- DIGITAL PORTAL BENEFIT WITHOUT SCREENSHOT ---------- */
    .portal-band{
      position:relative;overflow:hidden;
      border-top:1px solid rgba(255,255,255,.08);
      background:linear-gradient(135deg,#0f1425,#1a2440);
    }
    .portal-band::after{
      content:"";position:absolute;width:470px;height:470px;right:-180px;top:-210px;
      border-radius:50%;border:68px solid rgba(244,49,203,.1);
    }
    .portal-grid{
      position:relative;z-index:2;
      display:grid;grid-template-columns:1fr 1fr;gap:55px;align-items:center;
    }
    .portal-ui{
      min-height:360px;padding:26px;
      border:1px solid rgba(255,255,255,.11);border-radius:30px;
      background:rgba(255,255,255,.055);
      box-shadow:0 28px 80px rgba(0,0,0,.18);
    }
    .portal-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:25px}
    .portal-top strong{font-size:14px}
    .portal-top span{color:var(--pink-light);font-size:10px;font-weight:700}
    .progress-card{
      padding:19px;border:1px solid rgba(255,255,255,.08);border-radius:20px;background:rgba(255,255,255,.05)
    }
    .progress-card small{color:rgba(255,255,255,.55);font-size:9px;text-transform:uppercase;letter-spacing:.1em}
    .progress-card strong{display:block;margin-top:6px;font-size:17px}
    .progress-line{height:9px;margin-top:18px;overflow:hidden;border-radius:99px;background:rgba(255,255,255,.08)}
    .progress-line i{display:block;width:74%;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--pink),var(--aqua))}
    .portal-mini-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:10px}
    .portal-mini{padding:16px;border:1px solid rgba(255,255,255,.08);border-radius:17px;background:rgba(255,255,255,.035)}
    .portal-mini b{display:block;color:var(--pink-light);font-size:10px;letter-spacing:.08em}
    .portal-mini span{display:block;margin-top:7px;color:rgba(255,255,255,.62);font-size:10px;line-height:1.5}

    /* ---------- PRICING ---------- */
    .price-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
    .price{
      padding:23px;border:1px solid var(--line);border-radius:23px;background:#fff;
      transition:.25s ease;
    }
    .price:hover{transform:translateY(-5px);box-shadow:0 18px 45px rgba(45,22,42,.08)}
    .price small{color:var(--pink);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
    .price h3{min-height:52px;margin:12px 0 20px;font-size:20px;line-height:1.25}
    .price div{padding-top:16px;border-top:1px solid var(--line);color:var(--muted);font-size:10px;line-height:1.5}

    /* ---------- LOCAL ---------- */
    .local{
      position:relative;overflow:hidden;padding:52px;border:1px solid var(--line);border-radius:35px;
      background:linear-gradient(135deg,#fff1fb 0%,#f4feff 100%);
    }
    .local::after{
      content:"WATER";position:absolute;right:-20px;bottom:-35px;
      color:transparent;-webkit-text-stroke:1.3px rgba(85,213,223,.19);
      font-size:130px;font-weight:800;line-height:1;letter-spacing:-.08em;
    }
    .local>*{position:relative;z-index:2}
    .local p{max-width:760px;color:var(--muted);font-size:13px;line-height:1.75}

    /* ---------- FAQ ---------- */
    .faq{max-width:920px;margin:auto;border-top:1px solid var(--line)}
    .faq-item{border-bottom:1px solid var(--line)}
    .faq-q{
      width:100%;padding:22px 2px;display:flex;align-items:center;justify-content:space-between;gap:22px;
      border:0;background:transparent;text-align:left;color:var(--ink);font-weight:700;font-size:14px;cursor:pointer
    }
    .faq-plus{
      width:32px;height:32px;flex:0 0 32px;display:grid;place-items:center;border:1px solid var(--line);
      border-radius:50%;color:var(--pink);font-size:18px;transition:.25s ease
    }
    .faq-a{
      max-height:0;overflow:hidden;color:var(--muted);font-size:12px;line-height:1.7;
      transition:max-height .32s ease,padding .32s ease
    }
    .faq-item.open .faq-a{max-height:240px;padding:0 58px 22px 2px}
    .faq-item.open .faq-plus{transform:rotate(45deg);background:var(--pink);border-color:var(--pink);color:#fff}

    /* ---------- FINAL CTA / WATER WAVE ---------- */
    .final{
      position:relative;overflow:hidden;padding:105px 0 90px;background:var(--pink);color:#fff
    }
    .final-wave{
      position:absolute;left:-10%;right:-10%;top:-68px;height:125px;
      border-radius:0 0 50% 50% / 0 0 100% 100%;
      background:#fff;
    }
    .final-wave::after{
      content:"";position:absolute;left:0;right:0;bottom:-30px;height:60px;
      border-radius:50%;border-bottom:2px solid rgba(255,255,255,.28);
      animation:waveFloat 7s ease-in-out infinite alternate;
    }
    .final-grid{
      position:relative;z-index:2;display:grid;grid-template-columns:1.1fr .9fr;gap:55px;align-items:end
    }
    .final h2{
      margin:0;color:#fff;font-size:clamp(55px,7vw,94px)
    }
    .final-outline{color:transparent;-webkit-text-stroke:1.5px rgba(255,255,255,.79)}
    .final p{max-width:650px;margin:18px 0 0;color:rgba(255,255,255,.82);font-size:14px;line-height:1.7}
    .contacts{display:grid;gap:9px}
    .contact{
      display:flex;align-items:center;justify-content:space-between;gap:16px;
      padding:16px 17px;border:1px solid rgba(255,255,255,.22);border-radius:16px;
      background:rgba(255,255,255,.11);backdrop-filter:blur(10px)
    }
    .contact small{display:block;color:rgba(255,255,255,.65);font-size:9px;letter-spacing:.1em;text-transform:uppercase}
    .contact strong{display:block;margin-top:3px;font-size:12px}
    .contact b{font-size:18px}

    /* ---------- FOOTER ---------- */
    footer{padding:42px 0;background:#0e1321;color:rgba(255,255,255,.65)}
    .footer-grid{display:grid;grid-template-columns:1.2fr .8fr .8fr 1.1fr;gap:34px}
    .footer-logo{display:flex;align-items:center;gap:9px;color:#fff;font-weight:800}
    .footer-logo img{width:52px;height:52px;border-radius:50%;object-fit:contain;background:#fff}
    .footer-copy{max-width:330px;margin-top:12px;font-size:10px;line-height:1.65}
    .footer-title{margin-bottom:10px;color:#fff;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
    .footer-links{display:grid;gap:8px;font-size:10px}
    .footer-links a:hover{color:#fff}
    .footer-bottom{
      display:flex;justify-content:space-between;gap:20px;
      margin-top:34px;padding-top:20px;border-top:1px solid rgba(255,255,255,.08);font-size:9px
    }

    /* Reveal & image movement */
    .reveal{opacity:0;transform:translateY(26px);transition:opacity .75s cubic-bezier(.2,.7,.2,1),transform .75s cubic-bezier(.2,.7,.2,1)}
    .reveal.in{opacity:1;transform:none}
    .image-reveal{clip-path:inset(0 0 100% 0 round 36px);transition:clip-path 1s cubic-bezier(.18,.74,.18,1)}
    .image-reveal.in{clip-path:inset(0 0 0 0 round 36px)}

    @media(max-width:1030px){
      .nav-links{display:none}
      .portal-link{display:none}
      .menu{display:block}
      .hero-grid,.why-grid,.pool-grid,.portal-grid,.final-grid{grid-template-columns:1fr}
      .hero{padding-top:132px}
      .hero-visual{min-height:540px}
      .trust-grid{grid-template-columns:repeat(3,1fr)}
      .trust:nth-child(3),.trust:nth-child(6){border-right:0}
      .trust:nth-child(-n+3){border-bottom:1px solid var(--line)}
      .qual-grid,.price-grid{grid-template-columns:1fr 1fr}
      .why-photo{min-height:560px}
      .pool-photo{min-height:520px}
      .footer-grid{grid-template-columns:1fr 1fr}
    }

    @media(max-width:720px){
      :root{--wrap:min(100% - 26px,1200px)}
      .section{padding:84px 0}
      .header{padding:8px 0}
      .nav{min-height:61px;padding:6px 7px 6px 10px}
      .brand img{width:43px;height:43px}
      .brand strong{font-size:17px}
      .nav-actions>.btn{display:none}
      .hero{min-height:auto;padding:112px 0 78px}
      .hero-grid{gap:42px}
      h1{font-size:clamp(49px,15vw,72px)}
      .hero-visual{min-height:430px}
      .hero-photo{inset:0 6px 20px 20px;border-radius:30px 30px 80px 30px}
      .hero-badge{right:-1px;bottom:34px;width:170px}
      .water-lens{width:145px;height:145px;left:-6px}
      .bubble-a{right:5px}
      .trust-wrap{margin-top:-18px}
      .trust-grid{grid-template-columns:1fr 1fr}
      .trust:nth-child(2),.trust:nth-child(4),.trust:nth-child(6){border-right:0}
      .trust:nth-child(3),.trust:nth-child(5){border-right:1px solid var(--line)}
      .trust:nth-child(-n+4){border-bottom:1px solid var(--line)}
      .trust:last-child{grid-column:auto}
      .lesson-row{grid-template-columns:72px 1fr 36px;gap:10px;padding:24px 2px}
      .lesson-row p{grid-column:2/4}
      .lesson-no{font-size:41px}
      .marquee-item{padding:0 20px;font-size:34px}
      .marquee-item::after{margin-left:40px}
      .why-photo{min-height:500px;border-radius:31px 31px 84px 31px}
      .benefits{grid-template-columns:1fr}
      .pool-photo{min-height:400px}
      .temperature-stage{grid-template-columns:105px 1fr;gap:18px}
      .thermometer{transform:scale(.82);transform-origin:center}
      .temp-copy strong{font-size:82px}
      .qual-grid,.price-grid{grid-template-columns:1fr}
      .qual{min-height:165px}
      .portal-mini-grid{grid-template-columns:1fr}
      .local{padding:31px 24px}
      .local::after{font-size:82px}
      .final-grid{gap:35px}
      .footer-grid{grid-template-columns:1fr}
      .footer-bottom{display:grid}
    }

    @media(prefers-reduced-motion:reduce){
      html{scroll-behavior:auto}
      *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
      .reveal{opacity:1!important;transform:none!important}
      .image-reveal{clip-path:none!important}
      .marquee-track{animation:none!important}
    }
  
    /* ---------- OFFICIAL LESSON ENQUIRY FORM ---------- */
    .enquiry-section{
      overflow:hidden;
      background:
        radial-gradient(circle at 90% 12%,rgba(85,213,223,.12),transparent 25rem),
        radial-gradient(circle at 8% 88%,rgba(244,49,203,.08),transparent 23rem),
        linear-gradient(180deg,#fff 0%,#fff8fd 100%);
    }
    .enquiry-heading{max-width:790px;margin-bottom:36px}
    .official-form-card{
      overflow:hidden;
      border:1px solid var(--line);
      border-radius:32px;
      background:#fff;
      box-shadow:0 26px 75px rgba(31,24,40,.11);
    }
    .official-form-top{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:24px;
      padding:24px 26px;
      border-bottom:1px solid var(--line);
      background:
        radial-gradient(circle at 90% 10%,rgba(85,213,223,.12),transparent 17rem),
        linear-gradient(135deg,#fff7fd,#f5feff);
    }
    .official-form-top small{
      display:block;
      color:var(--pink);
      font-size:9px;
      font-weight:800;
      letter-spacing:.13em;
    }
    .official-form-top strong{
      display:block;
      margin-top:5px;
      color:var(--ink);
      font-size:19px;
      letter-spacing:-.025em;
    }
    .official-form-top span{
      display:block;
      margin-top:5px;
      color:var(--muted);
      font-size:11px;
    }
    .official-form-frame{
      position:relative;
      min-height:760px;
      background:#fff;
    }
    .official-form-frame iframe{
      display:block;
      width:100%;
      min-height:760px;
      height:80vh;
      max-height:980px;
      border:0;
      background:#fff;
    }
    .form-fallback{
      display:flex;
      align-items:center;
      gap:12px;
      flex-wrap:wrap;
      padding:16px 20px;
      border-top:1px solid var(--line);
      background:#fffafd;
    }
    .form-fallback strong{font-size:11px}
    .form-fallback span{flex:1;color:var(--muted);font-size:10px;min-width:220px}
    .form-fallback .btn{min-height:40px;padding:0 15px;font-size:10px}
    .enquiry-alt{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:24px;
      margin-top:18px;
      padding:17px 20px;
      border:1px solid var(--line);
      border-radius:18px;
      background:rgba(255,255,255,.72);
    }
    .enquiry-alt>span{color:var(--muted);font-size:11px;font-weight:600}
    .enquiry-alt>div{display:flex;gap:18px;flex-wrap:wrap}
    .enquiry-alt a{color:var(--pink-deep);font-size:11px;font-weight:800}

    @media(max-width:720px){
      .official-form-top{align-items:flex-start;display:grid;padding:20px}
      .official-form-top .btn{width:100%}
      .official-form-frame{min-height:680px}
      .official-form-frame iframe{min-height:680px;height:78vh}
      .form-fallback{display:grid}
      .form-fallback span{min-width:0}
      .form-fallback .btn{width:100%}
      .enquiry-alt{display:grid}
      .enquiry-alt>div{gap:13px}
    }

</style>

  <style id="swimtrain-v3-enhancements">
    /* READABILITY */
    .lead{font-size:17px;line-height:1.8}
    .body,.section-heading p{font-size:15.5px;line-height:1.8}
    .lesson-row p{font-size:13.5px;line-height:1.72}
    .trust strong{font-size:13px}
    .trust small{font-size:10px;line-height:1.5}
    .pool-point strong{font-size:13px}
    .pool-point span{font-size:11px}
    .faq-q{font-size:15px}
    .faq-a{font-size:13px}
    .footer-links,.footer-copy{font-size:11px}

    /* MORE COLOUR WITHOUT HURTING LEGIBILITY */
    #lessons{
      background:
        radial-gradient(circle at 95% 5%,rgba(85,213,223,.09),transparent 23rem),
        radial-gradient(circle at 4% 84%,rgba(244,49,203,.07),transparent 22rem),
        #fff;
    }
    #why{
      background:
        radial-gradient(circle at 8% 10%,rgba(244,49,203,.10),transparent 24rem),
        radial-gradient(circle at 90% 80%,rgba(85,213,223,.12),transparent 28rem),
        linear-gradient(135deg,#fff6fc,#f4feff);
    }
    #pricing{
      background:
        radial-gradient(circle at 12% 75%,rgba(85,213,223,.08),transparent 21rem),
        linear-gradient(180deg,#fffafe,#fff);
    }

    /* ANIMATED BUBBLES THROUGHOUT THE PAGE */
    .bubble-stream{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
    .bubble-stream i{
      position:absolute;bottom:-90px;border-radius:50%;
      border:1px solid rgba(85,213,223,.22);
      background:rgba(255,255,255,.12);
      box-shadow:inset 3px 3px 10px rgba(255,255,255,.25);
      animation:riseBubble 17s linear infinite;
    }
    .bubble-stream i:nth-child(1){left:5%;width:26px;height:26px;animation-duration:14s}
    .bubble-stream i:nth-child(2){left:17%;width:12px;height:12px;animation-delay:-7s;animation-duration:18s}
    .bubble-stream i:nth-child(3){left:34%;width:38px;height:38px;animation-delay:-11s;animation-duration:20s}
    .bubble-stream i:nth-child(4){left:52%;width:18px;height:18px;animation-delay:-3s;animation-duration:16s}
    .bubble-stream i:nth-child(5){left:69%;width:30px;height:30px;animation-delay:-9s;animation-duration:19s}
    .bubble-stream i:nth-child(6){left:80%;width:13px;height:13px;animation-delay:-5s;animation-duration:15s}
    .bubble-stream i:nth-child(7){left:91%;width:42px;height:42px;animation-delay:-13s;animation-duration:22s}
    .bubble-stream i:nth-child(8){left:60%;width:9px;height:9px;animation-delay:-2s;animation-duration:13s}
    @keyframes riseBubble{
      0%{transform:translate3d(0,0,0) scale(.75);opacity:0}
      8%{opacity:.8}
      45%{transform:translate3d(24px,-52vh,0) scale(1)}
      100%{transform:translate3d(-12px,-112vh,0) scale(1.2);opacity:0}
    }

    /* AVAILABILITY BAND */
    .availability-strip{
      position:relative;
      z-index:8;
      padding:28px 0;
      overflow:hidden;
      color:#fff;
      background:
        radial-gradient(circle at 90% 50%,rgba(85,213,223,.19),transparent 22rem),
        linear-gradient(115deg,#14192d 0%,#1a2340 68%,#182d47 100%);
      border-top:1px solid rgba(255,255,255,.07);
      border-bottom:1px solid rgba(255,255,255,.07);
    }
    .availability-strip::after{
      content:"";
      position:absolute;
      right:-70px;top:50%;
      width:310px;height:110px;
      transform:translateY(-50%);
      border:2px solid rgba(85,213,223,.20);
      border-radius:50%;
      box-shadow:0 0 0 28px rgba(244,49,203,.055),0 0 0 54px rgba(85,213,223,.04);
      animation:availabilityRipple 5s ease-in-out infinite alternate;
    }
    @keyframes availabilityRipple{to{transform:translateY(-50%) scale(1.12)}}
    .availability-inner{
      position:relative;z-index:2;
      display:flex;align-items:center;justify-content:space-between;gap:34px
    }
    .availability-kicker{
      display:block;margin-bottom:6px;color:var(--aqua);font-size:10px;font-weight:800;letter-spacing:.13em
    }
    .availability-inner strong{font-size:22px;letter-spacing:-.035em}
    .availability-inner p{margin:6px 0 0;color:rgba(255,255,255,.66);font-size:12px;line-height:1.55}
    .availability-actions{display:flex;flex-wrap:wrap;gap:9px;min-width:max-content}
    .btn-aqua{background:var(--aqua);color:#082733;box-shadow:0 12px 30px rgba(85,213,223,.18)}
    .btn-whatsapp{color:#fff;border-color:rgba(255,255,255,.16);background:rgba(255,255,255,.07)}

    /* SWIMMING / WATER-LIKE LESSON HOVERS */
    .lesson-row{position:relative;overflow:hidden}
    .lesson-row::before{
      content:"";position:absolute;z-index:-1;left:0;right:0;bottom:0;height:0;
      background:linear-gradient(90deg,rgba(85,213,223,.09),rgba(244,49,203,.06));
      border-radius:60% 50% 0 0 / 35% 35% 0 0;
      transition:height .35s ease
    }
    .lesson-row:hover::before{height:100%}

    /* SPECIALIST OPTIONS */
    .specialist-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:28px}
    .specialist-card{
      position:relative;overflow:hidden;min-height:195px;padding:24px;
      border-radius:25px;border:1px solid var(--line)
    }
    .specialist-card::after{
      content:"";position:absolute;width:170px;height:170px;border-radius:50%;right:-75px;bottom:-90px;
      border:28px solid rgba(255,255,255,.22)
    }
    .specialist-card span{font-size:9px;font-weight:800;letter-spacing:.12em}
    .specialist-card h3{max-width:420px;margin:14px 0 10px;font-size:21px;line-height:1.25;letter-spacing:-.035em}
    .specialist-card p{max-width:470px;margin:0;font-size:12px;line-height:1.65}
    .specialist-aqua{background:linear-gradient(135deg,#e9fdff,#bff7f8)}
    .specialist-aqua span{color:#078b99}
    .specialist-aqua p{color:#4d6d71}
    .specialist-pink{background:linear-gradient(135deg,#fff0fb,#ffd6f4)}
    .specialist-pink span{color:#bd229a}
    .specialist-pink p{color:#73536d}

    /* WATER CAUSTICS OVER REAL PHOTOS */
    .hero-photo::before,.pool-photo::before,.why-photo::before{
      content:"";position:absolute;z-index:3;inset:-20%;
      pointer-events:none;mix-blend-mode:screen;opacity:.18;
      background:
        radial-gradient(ellipse at 30% 40%,rgba(255,255,255,.95) 0 1.5%,transparent 2.5% 100%),
        radial-gradient(ellipse at 62% 48%,rgba(255,255,255,.8) 0 1%,transparent 2% 100%),
        radial-gradient(ellipse at 72% 18%,rgba(255,255,255,.7) 0 1.2%,transparent 2.3% 100%);
      background-size:110px 70px,150px 90px,125px 82px;
      animation:caustics 10s linear infinite alternate
    }
    @keyframes caustics{
      to{transform:translate3d(45px,26px,0) rotate(5deg) scale(1.08)}
    }

    /* THERMOMETER EXTRA MOTION */
    .thermo-fill::before{
      content:"";position:absolute;left:-60%;right:-60%;top:-12px;height:24px;
      border-radius:50%;background:rgba(255,255,255,.38);
      animation:thermoWave 2s ease-in-out infinite alternate
    }
    @keyframes thermoWave{to{transform:translateX(17px) scaleX(1.18)}}
    .temp-copy strong{filter:drop-shadow(0 7px 18px rgba(244,49,203,.12))}

    /* LOCATION */
    .location-section{
      overflow:hidden;
      background:
        radial-gradient(circle at 90% 40%,rgba(85,213,223,.14),transparent 25rem),
        linear-gradient(135deg,#fff,#fff7fc)
    }
    .location-grid{display:grid;grid-template-columns:1fr .82fr;gap:65px;align-items:center}
    .location-facts{display:grid;gap:10px;margin:28px 0}
    .location-facts>div{
      display:flex;align-items:center;gap:13px;padding:14px 0;border-bottom:1px solid var(--line)
    }
    .location-facts b{
      width:38px;height:38px;display:grid;place-items:center;border-radius:50%;
      background:var(--pink-pale);color:var(--pink);font-size:15px
    }
    .location-facts span{display:grid}
    .location-facts strong{font-size:13px}
    .location-facts small{margin-top:3px;color:var(--muted);font-size:10px}
    .location-actions{display:flex;flex-wrap:wrap;gap:9px}
    .location-water-card{
      position:relative;min-height:430px;display:flex;flex-direction:column;align-items:center;justify-content:center;
      overflow:hidden;border-radius:42px;color:#fff;text-align:center;
      background:
        radial-gradient(circle at 28% 22%,rgba(255,255,255,.28),transparent 14rem),
        linear-gradient(145deg,#11b7d4,#0877bd 76%);
      box-shadow:0 30px 80px rgba(13,118,155,.18)
    }
    .location-water-card::before{
      content:"";position:absolute;inset:-15%;opacity:.22;
      background:repeating-radial-gradient(ellipse at 50% 110%,rgba(255,255,255,.45) 0 2px,transparent 3px 19px);
      animation:mapWater 9s ease-in-out infinite alternate
    }
    @keyframes mapWater{to{transform:translateY(-20px) scale(1.08)}}
    .location-pin{
      position:relative;z-index:3;width:68px;height:68px;display:grid;place-items:center;margin-bottom:20px;
      border-radius:50%;background:var(--pink);font-size:28px;box-shadow:0 0 0 14px rgba(255,255,255,.12)
    }
    .location-water-card strong{position:relative;z-index:3;font-size:43px;line-height:1;letter-spacing:-.06em}
    .location-water-card span{position:relative;z-index:3;margin-top:7px;font-size:13px;font-weight:700;letter-spacing:.06em}
    .location-water-card small{position:relative;z-index:3;margin-top:6px;color:rgba(255,255,255,.72);font-size:11px}
    .map-ripple{
      position:absolute;left:50%;top:49%;border:1px solid rgba(255,255,255,.34);border-radius:50%;
      transform:translate(-50%,-50%);animation:mapRipple 4.5s ease-out infinite
    }
    .ripple-one{width:180px;height:78px}
    .ripple-two{width:290px;height:125px;animation-delay:-1.5s}
    .ripple-three{width:400px;height:170px;animation-delay:-3s}
    @keyframes mapRipple{0%{opacity:.8;scale:.6}100%{opacity:0;scale:1.25}}
    .location-wave{position:absolute;left:-10%;right:-10%;height:80px;border:1px solid rgba(255,255,255,.2);border-radius:50%}
    .wave-1{bottom:-25px;animation:locWave 6s ease-in-out infinite alternate}
    .wave-2{bottom:15px;animation:locWave 8s ease-in-out infinite alternate-reverse}
    @keyframes locWave{to{transform:translateX(35px) scaleX(1.08)}}

    /* QUICK BOOKING */
    .quick-book{
      position:fixed;z-index:80;right:18px;bottom:20px;display:flex;align-items:center;gap:8px;
      transition:.25s ease
    }
    .quick-book-main{
      min-height:52px;padding:0 18px;display:flex;align-items:center;gap:14px;
      border-radius:999px;background:var(--pink);color:#fff;box-shadow:0 18px 45px rgba(244,49,203,.30);
      font-size:11px;font-weight:800;letter-spacing:.04em
    }
    .quick-book-main b{font-size:18px}
    .quick-book-mini{
      width:52px;height:52px;display:grid;place-items:center;border-radius:50%;
      background:#1fca68;color:#fff;font-size:10px;font-weight:800;
      box-shadow:0 16px 38px rgba(31,202,104,.22)
    }
    .mobile-book-dock{display:none}

    /* Button sheen / bubble hover */
    .btn{position:relative;overflow:hidden}
    .btn::after{
      content:"";position:absolute;top:-140%;left:-30%;width:30%;height:380%;
      background:rgba(255,255,255,.24);transform:rotate(20deg);transition:left .45s ease
    }
    .btn:hover::after{left:120%}

    @media(max-width:1030px){
      .trust-grid{grid-template-columns:repeat(3,1fr)!important}
      .trust:nth-child(3n){border-right:0}
      .availability-inner{align-items:flex-start}
      .location-grid{grid-template-columns:1fr}
      .location-water-card{min-height:370px}
    }
    @media(max-width:720px){
      body{padding-bottom:66px}
      .trust-grid{grid-template-columns:1fr 1fr!important}
      .trust:nth-child(odd){border-right:1px solid var(--line)}
      .trust:nth-child(even){border-right:0}
      .availability-inner{display:grid}
      .availability-actions{min-width:0}
      .availability-actions .btn{flex:1}
      .specialist-grid{grid-template-columns:1fr}
      .location-water-card{min-height:330px}
      .location-water-card strong{font-size:35px}
      .quick-book{display:none}
      .mobile-book-dock{
        position:fixed;z-index:110;left:0;right:0;bottom:0;
        display:grid;grid-template-columns:.72fr 1.4fr .9fr;
        min-height:64px;padding:7px max(8px,env(safe-area-inset-left)) calc(7px + env(safe-area-inset-bottom));
        background:rgba(14,19,33,.97);backdrop-filter:blur(15px);
        border-top:1px solid rgba(255,255,255,.08)
      }
      .mobile-book-dock a{
        display:grid;place-items:center;border-radius:13px;color:#fff;font-size:9px;font-weight:800;letter-spacing:.04em
      }
      .mobile-book-dock .dock-book{background:var(--pink);font-size:10px}
      .mobile-book-dock a:first-child,.mobile-book-dock a:last-child{color:rgba(255,255,255,.77)}
    }
    @media(prefers-reduced-motion:reduce){
      .bubble-stream,.availability-strip::after,.hero-photo::before,.pool-photo::before,.why-photo::before,
      .thermo-fill::before,.map-ripple,.location-wave,.location-water-card::before{animation:none!important}
    }
  </style>


  <style id="pool-section-fix">
    .pool-photo{
      display:block!important;
      min-height:560px!important;
      background:linear-gradient(135deg,#b9f1f4,#62ccd8)!important;
      opacity:1;
    }
    .pool-photo img{
      display:block!important;
      opacity:1!important;
      visibility:visible!important;
    }
    .temperature-stage{
      min-width:0;
    }
    .temp-copy strong{
      white-space:nowrap;
      font-size:clamp(76px,8vw,118px)!important;
      line-height:.82!important;
    }
    @media(max-width:720px){
      .pool-photo{min-height:390px!important}
      .temp-copy strong{font-size:76px!important}
    }
  </style>


  <style id="obvious-water-wave-system">
    /* The design language is now recognisable WATER WAVES, not abstract circles. */

    .ocean-wave-bg{
      position:absolute;
      left:0;right:0;
      pointer-events:none;
      overflow:hidden;
      z-index:0;
    }
    .ocean-wave-bg-a{
      top:540px;
      height:220px;
      opacity:.55;
    }
    .ocean-wave-bg svg{
      width:130%;
      height:100%;
      animation:waveSlide 11s linear infinite alternate;
    }
    .wave-fill-1{fill:rgba(85,213,223,.12)}
    .wave-line{
      fill:none;
      stroke:#55d5df;
      stroke-width:3;
      stroke-linecap:round;
      opacity:.42;
    }

    .wave-separator{
      position:relative;
      z-index:4;
      height:110px;
      margin-top:-1px;
      overflow:hidden;
      pointer-events:none;
      background:transparent;
    }
    .wave-separator svg{
      width:135%;
      height:100%;
      margin-left:-15%;
      animation:waveSlide 8s ease-in-out infinite alternate;
    }
    .wave-separator.wave-flip{
      transform:scaleY(-1);
      margin-top:-18px;
      margin-bottom:-18px;
    }
    .wave-layer-back{
      fill:rgba(85,213,223,.28);
    }
    .wave-layer-front{
      fill:rgba(11,170,210,.18);
    }
    .wave-crest{
      fill:none;
      stroke:#55d5df;
      stroke-width:3.5;
      opacity:.7;
      stroke-linecap:round;
    }
    .wave-dark .wave-layer-back{fill:rgba(244,49,203,.18)}
    .wave-dark .wave-layer-front{fill:rgba(85,213,223,.22)}
    .wave-dark .wave-crest{stroke:#55d5df;opacity:.75}

    @keyframes waveSlide{
      0%{transform:translateX(-3%) translateY(0)}
      50%{transform:translateX(1.5%) translateY(-7px)}
      100%{transform:translateX(4%) translateY(2px)}
    }

    /* Hero: unmistakable layered ocean waves. */
    .hero-ocean{
      position:absolute;
      left:-7%;right:-7%;bottom:-1px;
      height:210px;
      z-index:2;
      overflow:hidden;
      pointer-events:none;
    }
    .hero-ocean svg{
      width:125%;
      height:100%;
      animation:heroWaveMove 9s ease-in-out infinite alternate;
    }
    .hero-wave-back{fill:rgba(85,213,223,.24)}
    .hero-wave-front{fill:rgba(11,170,210,.13)}
    .hero-wave-glint{
      fill:none;
      stroke:rgba(255,255,255,.8);
      stroke-width:4;
      stroke-linecap:round;
      filter:drop-shadow(0 3px 5px rgba(11,170,210,.12));
    }
    @keyframes heroWaveMove{
      0%{transform:translateX(-3%) translateY(0) scaleX(1)}
      100%{transform:translateX(4%) translateY(-12px) scaleX(1.04)}
    }

    /* Water surface directly behind 32°C thermometer area. */
    .temperature-water{
      position:relative;
      height:95px;
      margin:-5px 0 -38px;
      overflow:hidden;
      opacity:.78;
      z-index:0;
    }
    .temperature-water svg{
      width:125%;
      height:100%;
      margin-left:-12%;
      animation:temperatureWave 5.5s ease-in-out infinite alternate;
    }
    .temperature-water path:first-child{
      fill:linear-gradient(#55d5df,#0baad2);
      fill:rgba(85,213,223,.22);
    }
    .temperature-water-line{
      fill:none;
      stroke:#0baad2;
      stroke-width:4;
      stroke-linecap:round;
      opacity:.65;
    }
    @keyframes temperatureWave{
      from{transform:translateX(-3%) translateY(2px)}
      to{transform:translateX(5%) translateY(-8px)}
    }
    .temperature-stage{
      position:relative;
      z-index:2;
    }

    /* Make all water labels visually tie back to real waves. */
    .pool-section{
      background:
        linear-gradient(180deg,rgba(85,213,223,.14) 0,rgba(255,255,255,.96) 220px,#fff 100%)!important;
    }
    .pool-section::after{
      content:"";
      position:absolute;
      left:0;right:0;bottom:0;
      height:100px;
      opacity:.22;
      background:
        radial-gradient(90px 32px at 5% 50%,transparent 66%,#55d5df 68% 70%,transparent 72%),
        radial-gradient(110px 38px at 19% 50%,transparent 66%,#55d5df 68% 70%,transparent 72%),
        radial-gradient(100px 34px at 36% 50%,transparent 66%,#0baad2 68% 70%,transparent 72%),
        radial-gradient(120px 40px at 57% 50%,transparent 66%,#55d5df 68% 70%,transparent 72%),
        radial-gradient(95px 32px at 78% 50%,transparent 66%,#0baad2 68% 70%,transparent 72%),
        radial-gradient(115px 38px at 96% 50%,transparent 66%,#55d5df 68% 70%,transparent 72%);
      background-repeat:repeat-x;
      animation:smallWaveDrift 9s linear infinite;
      pointer-events:none;
    }
    @keyframes smallWaveDrift{
      to{background-position:180px 0,220px 0,200px 0,240px 0,190px 0,230px 0}
    }

    /* Location graphic gets visibly water-filled rather than just blue. */
    .location-ocean{
      position:absolute;
      z-index:1;
      left:-8%;right:-8%;bottom:0;
      height:58%;
      overflow:hidden;
    }
    .location-ocean svg{
      width:125%;
      height:100%;
      animation:locationWaveMove 6.5s ease-in-out infinite alternate;
    }
    .location-ocean-back{fill:rgba(255,255,255,.22)}
    .location-ocean-front{fill:rgba(3,98,154,.34)}
    @keyframes locationWaveMove{
      from{transform:translateX(-4%) translateY(0)}
      to{transform:translateX(4%) translateY(-10px)}
    }
    .location-pin,.location-water-card>strong,.location-water-card>span,.location-water-card>small{
      z-index:4!important;
    }

    /* Simple wave underline for section kickers. */
    .kicker::after{
      content:"≈≈";
      display:inline-block;
      margin-left:8px;
      color:var(--aqua-dark);
      font-size:16px;
      font-weight:400;
      letter-spacing:-4px;
      transform:scaleX(1.4);
      opacity:.72;
    }

    @media(max-width:720px){
      .wave-separator{height:75px}
      .hero-ocean{height:150px}
      .ocean-wave-bg-a{top:500px;height:160px}
      .temperature-water{height:72px;margin-bottom:-28px}
    }

    @media(prefers-reduced-motion:reduce){
      .ocean-wave-bg svg,
      .wave-separator svg,
      .hero-ocean svg,
      .temperature-water svg,
      .location-ocean svg,
      .pool-section::after{
        animation:none!important;
      }
    }
  </style>


  <style id="google-map-location-section">
    .google-map-card{
      overflow:hidden;
      min-height:500px;
      display:grid;
      grid-template-rows:auto 1fr auto;
      border:1px solid var(--line);
      border-radius:34px;
      background:#fff;
      box-shadow:0 28px 75px rgba(23,64,79,.12);
    }
    .google-map-top{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:22px;
      padding:20px 22px;
      border-bottom:1px solid var(--line);
      background:linear-gradient(135deg,#fff,#f3feff);
    }
    .google-map-top div{display:grid}
    .google-map-top span{
      color:var(--pink);
      font-size:9px;
      font-weight:800;
      letter-spacing:.12em;
    }
    .google-map-top strong{
      margin-top:4px;
      color:var(--ink);
      font-size:15px;
      letter-spacing:-.025em;
    }
    .google-map-top small{
      margin-top:2px;
      color:var(--muted);
      font-size:10px;
    }
    .google-map-top a{
      min-width:max-content;
      padding:10px 14px;
      border-radius:999px;
      background:var(--pink);
      color:#fff;
      font-size:10px;
      font-weight:800;
      transition:.22s ease;
    }
    .google-map-top a:hover{transform:translateY(-2px)}
    .google-map-frame{
      position:relative;
      min-height:390px;
      background:linear-gradient(135deg,#dff8fb,#e7edf0);
      overflow:hidden;
    }
    .google-map-frame::before{
      content:"Loading map…";
      position:absolute;
      inset:0;
      display:grid;
      place-items:center;
      color:#72808b;
      font-size:12px;
      z-index:0;
    }
    .google-map-frame iframe{
      position:absolute;
      inset:0;
      z-index:1;
      display:block;
      width:100%;
      height:100%;
      filter:saturate(.92) contrast(.96);
    }
    .google-map-bottom{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:18px;
      padding:15px 20px;
      border-top:1px solid var(--line);
      background:#fff;
      color:var(--muted);
      font-size:10px;
    }
    .google-map-bottom span{
      display:flex;
      align-items:center;
      gap:8px;
    }
    .google-map-bottom b{
      width:25px;
      height:25px;
      display:grid;
      place-items:center;
      border-radius:50%;
      background:var(--pink-pale);
      color:var(--pink);
    }
    .google-map-bottom a{
      color:var(--pink);
      font-weight:800;
    }
    @media(max-width:720px){
      .google-map-card{min-height:440px}
      .google-map-frame{min-height:320px}
      .google-map-top{align-items:flex-start}
      .google-map-top a{padding:9px 11px}
      .google-map-bottom{align-items:flex-start;display:grid}
    }
  </style>


  <style id="direct-contact-v6">
    .contact-choice-row{display:flex;flex-wrap:wrap;gap:9px}

    .contact-builder-grid{
      display:grid;
      grid-template-columns:.92fr 1.08fr;
      gap:64px;
      align-items:start;
    }
    .direct-contact-options{
      display:grid;
      gap:10px;
      margin-top:28px;
    }
    .direct-contact-options a{
      display:grid;
      grid-template-columns:42px 1fr auto;
      align-items:center;
      gap:13px;
      padding:13px 15px;
      border:1px solid var(--line);
      border-radius:17px;
      background:#fff;
      transition:.22s ease;
    }
    .direct-contact-options a:hover{
      transform:translateX(5px);
      border-color:rgba(244,49,203,.28);
    }
    .direct-contact-options b{
      width:42px;height:42px;
      display:grid;place-items:center;
      border-radius:50%;
      background:var(--pink-pale);
      color:var(--pink);
      font-size:13px;
    }
    .direct-contact-options span{display:grid}
    .direct-contact-options strong{font-size:12px}
    .direct-contact-options small{margin-top:3px;color:var(--muted);font-size:10px}
    .direct-contact-options i{color:var(--pink);font-size:18px;font-style:normal}

    .whatsapp-form{
      position:relative;
      overflow:hidden;
      padding:26px;
      border:1px solid var(--line);
      border-radius:28px;
      background:#fff;
      box-shadow:0 24px 65px rgba(28,23,30,.09);
    }
    .whatsapp-form::before{
      content:"";
      position:absolute;
      right:-80px;top:-90px;
      width:190px;height:190px;
      border-radius:50%;
      border:28px solid rgba(85,213,223,.10);
    }
    .whatsapp-form-head{
      position:relative;
      display:grid;
      margin-bottom:20px;
    }
    .whatsapp-form-head span{
      color:#1eae63;
      font-size:9px;
      font-weight:800;
      letter-spacing:.12em;
    }
    .whatsapp-form-head strong{
      margin-top:5px;
      color:var(--ink);
      font-size:18px;
      letter-spacing:-.03em;
    }
    .whatsapp-form label{
      position:relative;
      display:grid;
      gap:7px;
      margin-top:14px;
      color:var(--ink);
      font-size:11px;
      font-weight:700;
    }
    .whatsapp-form input,
    .whatsapp-form select,
    .whatsapp-form textarea{
      width:100%;
      border:1px solid var(--line);
      border-radius:14px;
      background:#fbfcfd;
      color:var(--ink);
      padding:13px 14px;
      outline:none;
      font:inherit;
      font-size:12px;
      font-weight:500;
      resize:vertical;
      transition:border-color .2s ease,box-shadow .2s ease;
    }
    .whatsapp-form input:focus,
    .whatsapp-form select:focus,
    .whatsapp-form textarea:focus{
      border-color:rgba(30,174,99,.48);
      box-shadow:0 0 0 4px rgba(30,174,99,.08);
    }
    .wa-send-button{
      width:100%;
      margin-top:18px;
      background:#1fca68!important;
      box-shadow:0 14px 32px rgba(31,202,104,.20)!important;
    }
    .wa-note{
      display:block;
      margin-top:10px;
      color:var(--muted);
      font-size:9px;
      line-height:1.55;
      text-align:center;
    }

    @media(max-width:900px){
      .contact-builder-grid{grid-template-columns:1fr;gap:35px}
    }
    @media(max-width:620px){
      .contact-choice-row{display:grid}
      .contact-choice-row .btn{width:100%}
      .whatsapp-form{padding:21px 17px}
    }
  </style>


  <style id="smooth-integrated-water-v7">
    /* Remove old circle / bubble visual language completely. */
    .water-lens,
    .hero-bubble,
    .ripple-stack,
    .bubble-stream,
    .map-ripple{
      display:none!important;
    }

    /* Trust strip: simple wave glyph instead of a dot/circle. */
    .trust-wave{
      display:block;
      margin-bottom:7px;
      color:var(--aqua-dark);
      font-size:24px;
      line-height:.7;
      font-weight:500;
      letter-spacing:-5px;
      transform:scaleX(1.35);
      opacity:.85;
    }

    /* Sections become the canvas so waves overlap and fade into them. */
    .section,
    .final{
      overflow:hidden;
      isolation:isolate;
    }
    .section>.wrap,
    .final>.wrap{
      position:relative;
      z-index:3;
    }

    /* Smooth water ribbon embedded into a section — no separate block,
       no hard start/end and no rectangular cutoff. */
    .flow-wave{
      position:absolute;
      z-index:1;
      left:-7%;
      right:-7%;
      top:-80px;
      height:190px;
      pointer-events:none;
      opacity:.52;
      -webkit-mask-image:linear-gradient(to bottom,transparent 0%,#000 24%,#000 68%,transparent 100%);
      mask-image:linear-gradient(to bottom,transparent 0%,#000 24%,#000 68%,transparent 100%);
    }
    .flow-wave svg{
      width:116%;
      height:100%;
      margin-left:-8%;
      overflow:visible;
      animation:integratedWaveDrift 9s ease-in-out infinite alternate;
    }
    .flow-wave path{
      fill:none;
      vector-effect:non-scaling-stroke;
      stroke-linecap:round;
    }
    .flow-wave-soft{
      stroke:rgba(85,213,223,.30);
      stroke-width:18;
      filter:blur(8px);
    }
    .flow-wave-main{
      stroke:rgba(11,170,210,.50);
      stroke-width:5;
    }
    .flow-wave-highlight{
      stroke:rgba(244,49,203,.22);
      stroke-width:2.5;
    }

    /* Dark areas use lighter cyan/pink wave lines. */
    .dark .flow-wave-soft,
    .portal-band .flow-wave-soft{
      stroke:rgba(85,213,223,.18);
    }
    .dark .flow-wave-main,
    .portal-band .flow-wave-main{
      stroke:rgba(85,213,223,.52);
    }
    .dark .flow-wave-highlight,
    .portal-band .flow-wave-highlight{
      stroke:rgba(255,130,229,.34);
    }

    @keyframes integratedWaveDrift{
      0%{transform:translate3d(-2.5%,0,0) scaleX(1)}
      50%{transform:translate3d(1%,8px,0) scaleX(1.025)}
      100%{transform:translate3d(3.5%,-3px,0) scaleX(1.05)}
    }

    /* Hero waves are long strokes that fade into the hero/background. */
    .hero-ocean{
      position:absolute;
      z-index:2;
      left:-7%;
      right:-7%;
      bottom:-35px;
      height:235px;
      pointer-events:none;
      overflow:visible;
      opacity:.72;
      -webkit-mask-image:linear-gradient(to bottom,transparent 0%,#000 23%,#000 68%,transparent 100%);
      mask-image:linear-gradient(to bottom,transparent 0%,#000 23%,#000 68%,transparent 100%);
    }
    .hero-ocean svg{
      width:116%;
      height:100%;
      margin-left:-8%;
      animation:heroWaterFlow 10s ease-in-out infinite alternate;
    }
    .hero-water-stroke{
      fill:none;
      stroke-linecap:round;
      vector-effect:non-scaling-stroke;
    }
    .hero-water-stroke-1{
      stroke:rgba(85,213,223,.54);
      stroke-width:6;
    }
    .hero-water-stroke-2{
      stroke:rgba(11,170,210,.32);
      stroke-width:18;
      filter:blur(7px);
    }
    .hero-water-stroke-3{
      stroke:rgba(244,49,203,.20);
      stroke-width:3;
    }
    @keyframes heroWaterFlow{
      from{transform:translateX(-3%) translateY(0) scaleX(1)}
      to{transform:translateX(3.5%) translateY(-8px) scaleX(1.04)}
    }

    /* Pool section itself has a continuous water tint that eases in/out. */
    .pool-section{
      background:
        linear-gradient(
          180deg,
          rgba(85,213,223,0) 0%,
          rgba(85,213,223,.08) 10%,
          rgba(85,213,223,.12) 28%,
          rgba(255,255,255,.96) 67%,
          #fff 100%
        )!important;
    }
    .pool-section::before{
      content:""!important;
      position:absolute!important;
      inset:0!important;
      pointer-events:none!important;
      background:
        linear-gradient(110deg,transparent 0 22%,rgba(255,255,255,.42) 30%,transparent 39%),
        linear-gradient(72deg,transparent 0 48%,rgba(85,213,223,.08) 54%,transparent 61%)!important;
      opacity:.65;
      transform:none!important;
      border-radius:0!important;
      box-shadow:none!important;
    }
    .pool-section::after{
      display:none!important;
    }

    /* Wave movement beside 32°C is clear but it fades instead of ending in a box. */
    .temperature-water{
      position:relative;
      z-index:0;
      width:100%;
      height:120px;
      margin:4px 0 -55px;
      overflow:visible;
      opacity:.78;
      -webkit-mask-image:linear-gradient(to right,transparent 0%,#000 12%,#000 88%,transparent 100%);
      mask-image:linear-gradient(to right,transparent 0%,#000 12%,#000 88%,transparent 100%);
    }
    .temperature-water svg{
      width:122%;
      height:100%;
      margin-left:-11%;
      animation:tempWaterFlow 6.2s ease-in-out infinite alternate;
    }
    .temp-wave{
      fill:none;
      stroke-linecap:round;
      vector-effect:non-scaling-stroke;
    }
    .temp-wave-a{stroke:rgba(11,170,210,.58);stroke-width:4.5}
    .temp-wave-b{stroke:rgba(85,213,223,.27);stroke-width:15;filter:blur(5px)}
    .temp-wave-c{stroke:rgba(244,49,203,.18);stroke-width:2.5}
    @keyframes tempWaterFlow{
      from{transform:translateX(-2.5%) translateY(3px)}
      to{transform:translateX(3%) translateY(-6px)}
    }

    /* The final pink CTA gets a wave that fades into the pink instead of a hard white cut. */
    .final-wave{
      display:none!important;
    }
    .flow-wave-final{
      top:-64px;
      height:200px;
      opacity:.60;
      -webkit-mask-image:linear-gradient(to bottom,transparent 0%,#000 30%,#000 74%,transparent 100%);
      mask-image:linear-gradient(to bottom,transparent 0%,#000 30%,#000 74%,transparent 100%);
    }
    .flow-wave-final .flow-wave-soft{stroke:rgba(255,255,255,.18)}
    .flow-wave-final .flow-wave-main{stroke:rgba(255,255,255,.56)}
    .flow-wave-final svg{animation-duration:8s}

    /* No circular "water" decorations on the location card/map. */
    .location-water-card::before,
    .location-ocean,
    .location-wave{
      display:none!important;
    }

    @media(max-width:720px){
      .flow-wave{top:-54px;height:145px;opacity:.46}
      .hero-ocean{height:165px;bottom:-20px}
      .temperature-water{height:90px;margin-bottom:-40px}
    }

    @media(prefers-reduced-motion:reduce){
      .flow-wave svg,
      .hero-ocean svg,
      .temperature-water svg{
        animation:none!important;
      }
    }
  </style>


  <style id="swimtrain-v8-editorial-images">
    /* =========================================================
       HERO — photography is now part of the entire composition,
       not a small rounded AI-looking card.
       ========================================================= */
    .hero{
      min-height:820px;
      isolation:isolate;
    }
    .hero-grid{
      position:relative;
      z-index:5;
      grid-template-columns:minmax(0,650px) 1fr!important;
      gap:0!important;
    }
    .hero-grid>div:first-child{
      position:relative;
      z-index:8;
      max-width:650px;
      padding:32px 0 45px;
    }

    .hero-visual{
      position:absolute!important;
      z-index:1;
      top:0;
      right:0;
      bottom:0;
      width:min(66vw,1120px);
      min-height:0!important;
      pointer-events:none;
    }
    .hero-photo{
      position:absolute!important;
      inset:0!important;
      width:100%;
      height:100%;
      border-radius:0!important;
      overflow:hidden;
      box-shadow:none!important;
      background:#4bc7dd;
      -webkit-mask-image:
        linear-gradient(to right,transparent 0%,rgba(0,0,0,.14) 8%,#000 30%,#000 100%),
        linear-gradient(to bottom,#000 0%,#000 88%,transparent 100%);
      -webkit-mask-composite:source-in;
      mask-image:
        linear-gradient(to right,transparent 0%,rgba(0,0,0,.14) 8%,#000 30%,#000 100%);
    }
    .hero-photo img{
      width:100%!important;
      height:100%!important;
      object-fit:cover!important;
      object-position:53% 39%!important;
      transform:scale(1.035);
      filter:saturate(1.04) contrast(1.02);
    }
    .hero-photo::after{
      content:"";
      position:absolute;
      inset:0;
      z-index:2;
      background:
        linear-gradient(90deg,rgba(255,255,255,.95) 0%,rgba(255,255,255,.62) 15%,rgba(255,255,255,.08) 38%,transparent 55%),
        linear-gradient(180deg,rgba(255,255,255,.08),transparent 52%,rgba(255,255,255,.16));
      pointer-events:none;
    }
    .hero-photo-label{
      position:absolute;
      z-index:5;
      right:clamp(28px,5vw,86px);
      bottom:clamp(72px,9vw,120px);
      display:grid;
      max-width:255px;
      color:#fff;
      text-shadow:0 2px 18px rgba(0,35,52,.35);
    }
    .hero-photo-label span{
      font-size:9px;
      font-weight:800;
      letter-spacing:.14em;
      color:#fff;
    }
    .hero-photo-label strong{
      margin-top:5px;
      font-size:17px;
      line-height:1.25;
      letter-spacing:-.025em;
    }

    /* Make the left copy sit naturally over the image fade. */
    .hero::after{
      content:"";
      position:absolute;
      z-index:3;
      inset:0;
      pointer-events:none;
      background:
        linear-gradient(90deg,#fff 0%,rgba(255,255,255,.96) 31%,rgba(255,255,255,.62) 46%,rgba(255,255,255,0) 66%),
        radial-gradient(circle at 12% 30%,rgba(244,49,203,.10),transparent 24rem);
    }
    .hero-dots{z-index:4!important}
    .hero-ocean{z-index:6!important}

    /* =========================================================
       WHY SWIMTRAIN — use the real photo as an editorial panel
       that fades into the copy. No card, no hard edge.
       ========================================================= */
    #why{
      padding:88px 0!important;
      background:
        linear-gradient(90deg,rgba(85,213,223,.08),transparent 46%),
        linear-gradient(135deg,#fff8fd,#f8feff)!important;
    }
    .why-grid{
      grid-template-columns:minmax(420px,.98fr) minmax(460px,1.02fr)!important;
      gap:34px!important;
      min-height:610px;
    }
    .why-photo{
      display:block!important;
      position:relative!important;
      min-height:610px!important;
      width:115%!important;
      margin-left:-15%!important;
      opacity:1!important;
      transform:none!important;
      clip-path:none!important;
      border-radius:0!important;
      box-shadow:none!important;
      overflow:hidden!important;
      background:#0baad2!important;
      -webkit-mask-image:linear-gradient(to right,#000 0%,#000 70%,rgba(0,0,0,.82) 82%,transparent 100%);
      mask-image:linear-gradient(to right,#000 0%,#000 70%,rgba(0,0,0,.82) 82%,transparent 100%);
    }
    .why-photo img{
      display:block!important;
      visibility:visible!important;
      opacity:1!important;
      position:absolute!important;
      inset:0!important;
      width:100%!important;
      height:100%!important;
      object-fit:cover!important;
      object-position:50% 44%!important;
      filter:saturate(1.06) contrast(1.02);
    }
    .why-photo::after{
      content:"";
      position:absolute;
      inset:0;
      z-index:2;
      background:
        linear-gradient(90deg,transparent 48%,rgba(248,254,255,.08) 67%,rgba(248,254,255,.96) 100%),
        linear-gradient(180deg,transparent 75%,rgba(7,83,106,.14));
    }
    .why-grid>div:last-child{
      position:relative;
      z-index:4;
      padding:48px 0;
      align-self:center;
    }

    /* Slightly tighter page rhythm so sections don't feel vacant. */
    #lessons{padding-top:88px!important;padding-bottom:90px!important}
    #pool{padding-top:90px!important;padding-bottom:90px!important}
    #qualifications{padding-top:92px!important;padding-bottom:92px!important}
    #portal{padding-top:78px!important;padding-bottom:88px!important}
    #contact{padding-top:88px!important;padding-bottom:88px!important}
    #location{padding-top:88px!important;padding-bottom:88px!important}
    #faq{padding-top:88px!important;padding-bottom:88px!important}

    /* Keep wave decoration behind content and avoid visual dead space. */
    .flow-wave{opacity:.42!important}
    .section-heading{margin-bottom:38px!important}

    @media(max-width:1030px){
      .hero{
        min-height:auto;
        padding-bottom:0!important;
      }
      .hero-grid{
        display:block!important;
      }
      .hero-grid>div:first-child{
        width:var(--wrap);
        max-width:720px;
        margin:0;
        padding-bottom:60px;
      }
      .hero-visual{
        position:relative!important;
        width:100vw!important;
        height:540px!important;
        margin-left:calc(50% - 50vw);
        pointer-events:none;
      }
      .hero-photo{
        -webkit-mask-image:linear-gradient(to bottom,transparent 0%,#000 10%,#000 88%,transparent 100%);
        mask-image:linear-gradient(to bottom,transparent 0%,#000 10%,#000 88%,transparent 100%);
      }
      .hero-photo::after{
        background:linear-gradient(180deg,rgba(255,255,255,.90) 0%,rgba(255,255,255,.15) 17%,transparent 42%,rgba(255,255,255,.12));
      }
      .hero::after{
        background:
          radial-gradient(circle at 15% 18%,rgba(244,49,203,.10),transparent 22rem),
          linear-gradient(180deg,#fff 0%,rgba(255,255,255,.96) 51%,rgba(255,255,255,0) 71%);
      }
      .why-grid{
        grid-template-columns:1fr!important;
        min-height:0;
        gap:22px!important;
      }
      .why-photo{
        width:100vw!important;
        height:500px!important;
        min-height:500px!important;
        margin-left:calc(50% - 50vw)!important;
        -webkit-mask-image:linear-gradient(to bottom,#000 0%,#000 80%,transparent 100%);
        mask-image:linear-gradient(to bottom,#000 0%,#000 80%,transparent 100%);
      }
      .why-photo::after{
        background:linear-gradient(180deg,transparent 60%,rgba(248,254,255,.92) 100%);
      }
      .why-grid>div:last-child{padding:0 0 18px}
    }

    @media(max-width:720px){
      .hero-grid>div:first-child{padding-bottom:34px}
      .hero-visual{height:410px!important}
      .hero-photo img{object-position:55% 38%!important}
      .hero-photo-label{right:18px;bottom:55px;max-width:190px}
      .hero-photo-label strong{font-size:14px}
      .why-photo{
        height:390px!important;
        min-height:390px!important;
      }
      #why{padding-top:62px!important;padding-bottom:72px!important}
    }
  </style>


  <style id="swimtrain-v9-hero-polish">
    /* HERO ONLY — cleaner, more premium, less template-like. */
    .hero{
      min-height:790px!important;
      padding:138px 0 78px!important;
      background:
        radial-gradient(circle at 12% 20%,rgba(244,49,203,.12),transparent 29rem),
        radial-gradient(circle at 78% 18%,rgba(85,213,223,.12),transparent 31rem),
        linear-gradient(180deg,#fff 0%,#fffafd 100%)!important;
    }

    .hero::after{
      background:
        linear-gradient(
          90deg,
          #fff 0%,
          rgba(255,255,255,.99) 28%,
          rgba(255,255,255,.91) 39%,
          rgba(255,255,255,.42) 52%,
          rgba(255,255,255,.04) 68%,
          transparent 78%
        )!important;
    }

    .hero-grid{
      min-height:590px;
      grid-template-columns:minmax(0,650px) 1fr!important;
      align-items:center!important;
    }

    .hero-grid>div:first-child{
      padding:28px 0 58px!important;
      max-width:640px!important;
    }

    .hero .eyebrow{
      background:rgba(255,255,255,.88)!important;
      border-color:rgba(244,49,203,.17)!important;
      box-shadow:0 8px 25px rgba(244,49,203,.06);
    }

    .hero h1{
      margin-top:20px!important;
      max-width:650px!important;
      font-size:clamp(58px,6vw,90px)!important;
      line-height:.91!important;
      letter-spacing:-.072em!important;
    }

    .hero .lead{
      max-width:595px!important;
      font-size:16px!important;
      line-height:1.78!important;
      color:#626a7a!important;
    }

    .hero-actions{
      margin-top:27px!important;
    }

    .hero-actions .btn{
      min-height:52px!important;
      padding-inline:22px!important;
    }

    /* Big editorial image, but softly merged into the hero rather than boxed. */
    .hero-visual{
      top:-18px!important;
      bottom:-22px!important;
      right:-2vw!important;
      width:min(61vw,1030px)!important;
    }

    .hero-photo{
      inset:0!important;
      border-radius:0!important;
      box-shadow:none!important;
      -webkit-mask-image:
        linear-gradient(to right,transparent 0%,rgba(0,0,0,.18) 7%,rgba(0,0,0,.74) 21%,#000 34%,#000 100%),
        linear-gradient(to bottom,transparent 0%,#000 7%,#000 89%,transparent 100%)!important;
      -webkit-mask-composite:source-in!important;
      mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,.18) 7%,rgba(0,0,0,.74) 21%,#000 34%,#000 100%)!important;
    }

    .hero-photo img{
      object-position:54% 43%!important;
      transform:scale(1.07)!important;
      filter:saturate(1.08) contrast(1.035)!important;
    }

    .hero-photo::after{
      background:
        linear-gradient(90deg,rgba(255,255,255,.22) 0%,rgba(255,255,255,.06) 18%,transparent 45%),
        linear-gradient(180deg,rgba(6,89,112,.03),transparent 62%,rgba(5,76,100,.16))!important;
    }

    /* A restrained wave sweep across the bottom, integrated with the photo. */
    .hero-ocean{
      height:175px!important;
      bottom:-16px!important;
      opacity:.74!important;
      -webkit-mask-image:linear-gradient(to right,transparent 0%,#000 17%,#000 91%,transparent 100%)!important;
      mask-image:linear-gradient(to right,transparent 0%,#000 17%,#000 91%,transparent 100%)!important;
    }

    .hero-water-stroke-1{
      stroke:rgba(85,213,223,.58)!important;
      stroke-width:5!important;
    }
    .hero-water-stroke-2{
      stroke:rgba(11,170,210,.20)!important;
      stroke-width:12!important;
      filter:blur(5px)!important;
    }
    .hero-water-stroke-3{
      stroke:rgba(244,49,203,.17)!important;
      stroke-width:2!important;
    }

    /* Turn the existing tick row into one clear, premium proof strip. */
    .hero .micro{
      width:max-content;
      max-width:100%;
      display:flex!important;
      align-items:center;
      gap:0!important;
      margin-top:28px!important;
      padding:11px 13px!important;
      border:1px solid rgba(16,19,28,.08);
      border-radius:999px;
      background:rgba(255,255,255,.78);
      backdrop-filter:blur(13px);
      box-shadow:0 12px 34px rgba(27,16,29,.07);
      overflow:hidden;
    }

    .hero .micro span{
      padding:0 13px;
      border-right:1px solid rgba(16,19,28,.08);
      white-space:nowrap;
      font-size:10px!important;
    }
    .hero .micro span:first-child{padding-left:3px}
    .hero .micro span:last-child{
      border-right:0;
      padding-right:3px;
    }
    .hero .micro b{
      width:17px!important;
      height:17px!important;
      flex:0 0 17px;
      background:var(--pink)!important;
      font-size:9px!important;
    }

    /* Slight pink wash under the heading for depth without a card. */
    .hero-grid>div:first-child::before{
      content:"";
      position:absolute;
      z-index:-1;
      left:-90px;
      top:80px;
      width:520px;
      height:330px;
      border-radius:50%;
      background:radial-gradient(circle,rgba(244,49,203,.08),transparent 70%);
      filter:blur(9px);
      pointer-events:none;
    }

    @media(max-width:1030px){
      .hero{
        padding-bottom:0!important;
      }
      .hero-grid{
        min-height:0;
      }
      .hero-grid>div:first-child{
        padding-bottom:46px!important;
      }
      .hero-visual{
        right:auto!important;
        width:100vw!important;
        height:500px!important;
        top:auto!important;
        bottom:auto!important;
      }
      .hero-photo{
        -webkit-mask-image:linear-gradient(to bottom,transparent 0%,#000 10%,#000 90%,transparent 100%)!important;
        mask-image:linear-gradient(to bottom,transparent 0%,#000 10%,#000 90%,transparent 100%)!important;
      }
      .hero-photo img{
        object-position:53% 41%!important;
      }
      .hero::after{
        background:
          linear-gradient(180deg,#fff 0%,rgba(255,255,255,.99) 48%,rgba(255,255,255,.74) 58%,transparent 73%)!important;
      }
      .hero .micro{
        width:100%;
        border-radius:20px;
        flex-wrap:wrap;
        justify-content:flex-start;
      }
      .hero .micro span{
        border-right:0;
        padding:5px 9px!important;
      }
    }

    @media(max-width:720px){
      .hero{
        padding-top:104px!important;
      }
      .hero h1{
        font-size:clamp(48px,15vw,68px)!important;
      }
      .hero-visual{
        height:400px!important;
      }
      .hero-photo img{
        object-position:56% 40%!important;
      }
      .hero .micro{
        padding:9px 10px!important;
      }
    }
  </style>


  <style id="swimtrain-v10-water-hero">
    /* ---------------------------------------------------------
       HERO V10
       Image is back inside a deliberate container, but the
       container itself looks like a pool/water feature.
       --------------------------------------------------------- */

    .hero{
      min-height:820px!important;
      padding:140px 0 92px!important;
      background:
        radial-gradient(circle at 13% 17%,rgba(244,49,203,.22),transparent 30rem),
        radial-gradient(circle at 84% 20%,rgba(85,213,223,.24),transparent 33rem),
        radial-gradient(circle at 70% 88%,rgba(124,105,255,.08),transparent 28rem),
        linear-gradient(
          135deg,
          #fff8fd 0%,
          #ffeefa 28%,
          #f9fbff 57%,
          #eafcff 82%,
          #fff 100%
        )!important;
    }

    .hero::after{
      background:
        linear-gradient(90deg,rgba(255,255,255,.30),transparent 43%),
        linear-gradient(180deg,rgba(255,255,255,.05),transparent 70%)!important;
      z-index:1!important;
    }

    .hero-grid{
      position:relative!important;
      z-index:5!important;
      display:grid!important;
      grid-template-columns:minmax(0,1fr) minmax(500px,.92fr)!important;
      gap:58px!important;
      min-height:580px!important;
      align-items:center!important;
    }

    .hero-grid>div:first-child{
      position:relative!important;
      z-index:7!important;
      max-width:650px!important;
      padding:20px 0 42px!important;
    }

    .hero h1{
      max-width:650px!important;
      font-size:clamp(58px,6.2vw,92px)!important;
      line-height:.90!important;
      letter-spacing:-.074em!important;
    }

    .hero .lead{
      max-width:600px!important;
      color:#5e6575!important;
      font-size:16.5px!important;
      line-height:1.76!important;
    }

    /* Return the image to a container — but make it feel like water. */
    .hero-visual{
      position:relative!important;
      inset:auto!important;
      width:100%!important;
      min-height:570px!important;
      pointer-events:auto!important;
      z-index:6!important;
    }

    .hero-photo{
      position:absolute!important;
      inset:18px 0 20px 18px!important;
      overflow:hidden!important;

      /* Organic pool-like silhouette instead of generic rounded card. */
      border-radius:58px 58px 150px 58px!important;

      /* Water-coloured rim. */
      border:1px solid rgba(255,255,255,.72)!important;
      outline:10px solid rgba(85,213,223,.10);

      background:#0baad2!important;
      box-shadow:
        0 36px 85px rgba(11,126,160,.20),
        0 14px 36px rgba(244,49,203,.10),
        inset 0 0 0 1px rgba(255,255,255,.42)!important;

      -webkit-mask-image:none!important;
      mask-image:none!important;
    }

    .hero-photo img{
      width:100%!important;
      height:100%!important;
      object-fit:cover!important;
      object-position:52% 42%!important;
      transform:scale(1.035)!important;
      filter:saturate(1.08) contrast(1.025)!important;
    }

    /* Soft water sheen instead of a normal photo overlay. */
    .hero-photo::after{
      content:"";
      position:absolute;
      inset:0;
      z-index:3;
      pointer-events:none;
      background:
        linear-gradient(115deg,rgba(255,255,255,.18),transparent 30%),
        linear-gradient(180deg,transparent 54%,rgba(0,104,145,.18) 100%)!important;
      mix-blend-mode:screen;
    }

    /* Animated water layer inside the image container itself. */
    .hero-water-overlay{
      position:absolute;
      z-index:4;
      left:-8%;
      right:-8%;
      bottom:-4px;
      height:38%;
      pointer-events:none;
      opacity:.74;
      -webkit-mask-image:linear-gradient(to top,#000 0%,#000 58%,transparent 100%);
      mask-image:linear-gradient(to top,#000 0%,#000 58%,transparent 100%);
    }

    .hero-water-overlay svg{
      width:118%;
      height:100%;
      margin-left:-9%;
      animation:heroContainerWater 6.5s ease-in-out infinite alternate;
    }

    .hero-water-fill{
      fill:rgba(48,201,223,.17);
    }

    .hero-water-line-a,
    .hero-water-line-b{
      fill:none;
      stroke-linecap:round;
      vector-effect:non-scaling-stroke;
    }

    .hero-water-line-a{
      stroke:rgba(255,255,255,.72);
      stroke-width:4;
    }

    .hero-water-line-b{
      stroke:rgba(85,213,223,.72);
      stroke-width:3;
    }

    @keyframes heroContainerWater{
      from{transform:translateX(-3%) translateY(1px)}
      to{transform:translateX(4%) translateY(-10px)}
    }

    /* Large soft water reflection behind image container.
       It makes the container feel integrated, not pasted on. */
    .hero-visual::before{
      content:"";
      position:absolute;
      z-index:-1;
      width:84%;
      height:78%;
      right:-8%;
      bottom:-5%;
      border-radius:44% 56% 53% 47% / 55% 45% 55% 45%;
      background:
        radial-gradient(circle at 35% 30%,rgba(255,255,255,.38),transparent 24%),
        linear-gradient(145deg,rgba(85,213,223,.20),rgba(244,49,203,.07));
      filter:blur(22px);
      transform:rotate(-7deg);
    }

    /* Water-line echo around the lower-right of the container. */
    .hero-visual::after{
      content:"";
      position:absolute;
      z-index:-1;
      right:-36px;
      bottom:5px;
      width:73%;
      height:38%;
      border:2px solid rgba(85,213,223,.22);
      border-left-color:transparent;
      border-top-color:transparent;
      border-radius:0 0 58% 55%;
      transform:rotate(-4deg);
      animation:heroOuterWater 7s ease-in-out infinite alternate;
    }

    @keyframes heroOuterWater{
      to{transform:translateX(16px) translateY(-7px) rotate(-2deg)}
    }

    /* Proof strip becomes part of the composition rather than a floating card. */
    .hero .micro{
      width:auto!important;
      max-width:615px!important;
      display:flex!important;
      flex-wrap:wrap!important;
      gap:10px 18px!important;
      margin-top:25px!important;
      padding:0!important;
      border:0!important;
      border-radius:0!important;
      background:transparent!important;
      backdrop-filter:none!important;
      box-shadow:none!important;
      overflow:visible!important;
    }

    .hero .micro span{
      border:0!important;
      padding:0!important;
      font-size:10.5px!important;
      color:#505766!important;
    }

    .hero .micro b{
      width:18px!important;
      height:18px!important;
      flex:0 0 18px;
      background:linear-gradient(135deg,var(--pink),#ff76df)!important;
      box-shadow:0 5px 14px rgba(244,49,203,.17);
    }

    /* Keep bottom page wave but soften it so it blends into the gradient. */
    .hero-ocean{
      height:145px!important;
      bottom:-28px!important;
      opacity:.38!important;
      z-index:4!important;
      -webkit-mask-image:linear-gradient(to bottom,transparent 0%,#000 35%,transparent 100%)!important;
      mask-image:linear-gradient(to bottom,transparent 0%,#000 35%,transparent 100%)!important;
    }

    /* Give the hero a richer colour transition near the bottom. */
    .hero::before{
      content:"";
      position:absolute;
      z-index:0;
      left:0;right:0;bottom:0;
      height:230px;
      background:
        linear-gradient(
          180deg,
          transparent 0%,
          rgba(85,213,223,.045) 40%,
          rgba(244,49,203,.055) 100%
        );
      pointer-events:none;
    }

    @media(max-width:1030px){
      .hero{
        padding-bottom:84px!important;
      }

      .hero-grid{
        grid-template-columns:1fr!important;
        gap:34px!important;
      }

      .hero-grid>div:first-child{
        max-width:720px!important;
        padding-bottom:8px!important;
      }

      .hero-visual{
        height:520px!important;
        min-height:520px!important;
        width:100%!important;
        margin:0!important;
      }

      .hero-photo{
        inset:0!important;
        border-radius:42px 42px 105px 42px!important;
      }

      .hero::after{
        background:none!important;
      }
    }

    @media(max-width:720px){
      .hero{
        padding-top:105px!important;
        padding-bottom:65px!important;
      }

      .hero h1{
        font-size:clamp(48px,15vw,68px)!important;
      }

      .hero-visual{
        height:405px!important;
        min-height:405px!important;
      }

      .hero-photo{
        border-radius:30px 30px 78px 30px!important;
        outline-width:6px!important;
      }

      .hero-photo img{
        object-position:54% 40%!important;
      }

      .hero-water-overlay{
        height:34%;
      }
    }

    @media(prefers-reduced-motion:reduce){
      .hero-water-overlay svg,
      .hero-visual::after{
        animation:none!important;
      }
    }
  </style>


  <style id="swimtrain-legal-privacy">
    .privacy-note{
      margin:16px 0 0;
      padding:14px 16px;
      border:1px solid var(--line);
      border-radius:16px;
      background:#fffafd;
      color:var(--muted);
      font-size:10px;
      line-height:1.65;
    }
    .privacy-note a{color:var(--pink-deep);font-weight:800;text-decoration:underline;text-underline-offset:2px}
    .embed-consent{
      min-height:260px;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:28px;
      text-align:center;
      background:linear-gradient(135deg,#fff7fd,#f3fdff);
      border:1px dashed rgba(16,19,28,.16);
    }
    .embed-consent-inner{max-width:520px}
    .embed-consent strong{display:block;font-size:18px;color:var(--ink);letter-spacing:-.025em}
    .embed-consent p{margin:10px 0 16px;color:var(--muted);font-size:11px;line-height:1.65}
    .embed-consent-actions{display:flex;justify-content:center;flex-wrap:wrap;gap:8px}
    .cookie-banner{
      position:fixed;z-index:9999;left:18px;right:18px;bottom:18px;
      max-width:980px;margin:auto;padding:18px;
      display:none;align-items:center;justify-content:space-between;gap:22px;
      border:1px solid rgba(255,255,255,.14);border-radius:22px;
      color:#fff;background:rgba(14,19,33,.96);backdrop-filter:blur(18px);
      box-shadow:0 24px 80px rgba(0,0,0,.28);
    }
    .cookie-banner.show{display:flex}
    .cookie-copy strong{display:block;font-size:14px}
    .cookie-copy p{max-width:650px;margin:5px 0 0;color:rgba(255,255,255,.72);font-size:10px;line-height:1.55}
    .cookie-copy a{color:#fff;text-decoration:underline;text-underline-offset:2px}
    .cookie-actions{display:flex;flex-wrap:wrap;gap:7px;min-width:max-content}
    .cookie-btn{
      min-height:40px;padding:0 14px;border-radius:999px;border:1px solid rgba(255,255,255,.18);
      color:#fff;background:rgba(255,255,255,.07);font:inherit;font-size:10px;font-weight:800;cursor:pointer
    }
    .cookie-btn.primary{border-color:var(--pink);background:var(--pink)}
    .cookie-manage{background:none;border:0;padding:0;color:inherit;font:inherit;font-size:10px;text-decoration:underline;cursor:pointer}
    .footer-legal-links{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
    .footer-legal-links a,.footer-legal-links button{color:inherit;font:inherit;font-size:9px;background:none;border:0;padding:0;cursor:pointer}
    .footer-legal-links a:hover,.footer-legal-links button:hover{color:#fff}
    @media(max-width:720px){
      .cookie-banner{display:none;align-items:stretch;left:10px;right:10px;bottom:10px;padding:16px}
      .cookie-banner.show{display:grid}
      .cookie-actions{min-width:0}
      .cookie-actions .cookie-btn{flex:1}
    }
  </style>


  <style id="swimtrain-premium-scroll-upgrade">
    .site-scroll-progress{position:fixed;z-index:10000;left:0;top:0;width:100%;height:3px;pointer-events:none;background:rgba(255,255,255,.14)}
    .site-scroll-progress i{display:block;width:100%;height:100%;transform-origin:left center;transform:scaleX(var(--page-progress,0));background:linear-gradient(90deg,var(--aqua),var(--pink),var(--aqua));box-shadow:0 0 16px rgba(244,49,203,.26)}

    .reveal{transition-delay:var(--reveal-delay,0ms)}
    .reveal-left,.reveal-right{opacity:0;transition:opacity .85s cubic-bezier(.2,.75,.2,1),transform .85s cubic-bezier(.2,.75,.2,1);transition-delay:var(--reveal-delay,0ms)}
    .reveal-left{transform:translate3d(-38px,18px,0)}
    .reveal-right{transform:translate3d(38px,18px,0)}
    .reveal-left.in,.reveal-right.in{opacity:1;transform:none}

    [data-scroll-float]{--float-y:0px;--float-rotate:0deg;transform:translate3d(0,var(--float-y),0) rotate(var(--float-rotate));will-change:transform}

    #qualifications{--qual-progress:0;overflow:hidden;background:radial-gradient(circle at 12% 22%,rgba(85,213,223,.11),transparent 25rem),radial-gradient(circle at 87% 65%,rgba(244,49,203,.10),transparent 26rem),linear-gradient(145deg,#0e1321,#151d34 72%,#11182b)}
    #qualifications::after{content:"";position:absolute;width:600px;height:600px;right:-340px;top:50%;border-radius:50%;border:1px solid rgba(85,213,223,.15);box-shadow:0 0 0 70px rgba(85,213,223,.035),0 0 0 145px rgba(244,49,203,.025);transform:translateY(-50%) scale(calc(.85 + var(--qual-progress)*.18));opacity:calc(.30 + var(--qual-progress)*.55);pointer-events:none}
    .qual{position:relative;overflow:hidden;isolation:isolate}
    .qual::after{content:"";position:absolute;z-index:-1;width:130px;height:130px;left:-70px;bottom:-80px;border-radius:50%;background:radial-gradient(circle,rgba(244,49,203,.18),transparent 70%);transform:scale(calc(.75 + var(--qual-progress)*.65))}
    .qual::before{content:"";position:absolute;left:-120%;top:-20%;width:80%;height:140%;transform:skewX(-18deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.08),transparent);transition:left .7s ease;pointer-events:none}
    .qual:hover::before{left:145%}

    .credential-intro{margin-top:44px;padding-top:28px;border-top:1px solid rgba(255,255,255,.09);display:flex;align-items:end;justify-content:space-between;gap:28px}
    .credential-intro h3{margin:8px 0 0;color:#fff;font-size:clamp(28px,3.6vw,48px);line-height:1;letter-spacing:-.052em}
    .credential-intro p{max-width:520px;margin:0;color:rgba(255,255,255,.62);font-size:12px;line-height:1.7}
    .credential-logos{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:22px}
    .credential-logo-card{position:relative;min-height:220px;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1px solid rgba(255,255,255,.10);border-radius:28px;background:radial-gradient(circle at 85% 8%,rgba(85,213,223,.12),transparent 13rem),rgba(255,255,255,.055);box-shadow:0 24px 65px rgba(0,0,0,.14);transition:transform .35s ease,background .35s ease,border-color .35s ease}
    .credential-logo-card:hover{transform:translateY(-7px);border-color:rgba(255,255,255,.2);background:radial-gradient(circle at 85% 8%,rgba(85,213,223,.18),transparent 13rem),rgba(255,255,255,.075)}
    .credential-logo-card img{position:relative;z-index:2;width:min(72%,310px);max-height:130px;object-fit:contain;filter:drop-shadow(0 12px 24px rgba(0,0,0,.15));transition:transform .35s ease}
    .credential-logo-card:hover img{transform:scale(1.045)}
    .credential-logo-card.sta img{max-width:225px}
    .credential-logo-card small{position:absolute;z-index:3;left:18px;bottom:15px;color:rgba(255,255,255,.58);font-size:9px;font-weight:700;letter-spacing:.11em;text-transform:uppercase}

    .journey-section{--journey-progress:0;overflow:hidden;background:radial-gradient(circle at 10% 20%,rgba(244,49,203,.08),transparent 22rem),radial-gradient(circle at 90% 80%,rgba(85,213,223,.11),transparent 24rem),linear-gradient(180deg,#fff,#f8feff)}
    .journey-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:70px;align-items:start}
    .journey-copy{position:sticky;top:135px}
    .journey-steps{position:relative;display:grid;gap:18px;padding-left:34px}
    .journey-track{position:absolute;left:11px;top:23px;bottom:23px;width:3px;overflow:hidden;border-radius:99px;background:rgba(16,19,28,.08)}
    .journey-track i{display:block;width:100%;height:100%;transform-origin:top center;transform:scaleY(var(--journey-progress));border-radius:99px;background:linear-gradient(180deg,var(--pink),var(--aqua));box-shadow:0 0 20px rgba(85,213,223,.25)}
    .journey-step{position:relative;padding:24px 25px;border:1px solid var(--line);border-radius:24px;background:rgba(255,255,255,.88);backdrop-filter:blur(12px);box-shadow:0 16px 48px rgba(31,43,55,.06);transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease}
    .journey-step::before{content:"";position:absolute;left:-29px;top:29px;width:14px;height:14px;border:3px solid #fff;border-radius:50%;background:rgba(16,19,28,.16);box-shadow:0 0 0 1px rgba(16,19,28,.10);transition:.3s ease}
    .journey-step.is-active{transform:translateX(8px);border-color:rgba(244,49,203,.20);box-shadow:0 20px 58px rgba(244,49,203,.08)}
    .journey-step.is-active::before{background:var(--pink);box-shadow:0 0 0 8px rgba(244,49,203,.09)}
    .journey-step small{color:var(--pink-deep);font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
    .journey-step h3{margin:7px 0 7px;font-size:20px;letter-spacing:-.035em}
    .journey-step p{margin:0;color:var(--muted);font-size:11px;line-height:1.65}

    .progress-line i{width:100%;transform-origin:left center;transform:scaleX(var(--portal-progress,.25));transition:transform .08s linear}

    @media(max-width:900px){.credential-intro{display:grid;align-items:start}.journey-grid{grid-template-columns:1fr;gap:34px}.journey-copy{position:relative;top:auto}}
    @media(max-width:720px){.credential-logos{grid-template-columns:1fr}.credential-logo-card{min-height:175px}.journey-steps{padding-left:28px}.journey-track{left:9px}.journey-step::before{left:-26px}}
    @media(prefers-reduced-motion:reduce){.site-scroll-progress i,.progress-line i,.journey-track i{transition:none!important}[data-scroll-float]{transform:none!important}.journey-step.is-active{transform:none}}
  </style>


<style id="social-icon-upgrade">
  .socials a,
  .footer-socials a,
  a.social-link{
    width:42px;height:42px;
    display:inline-flex;
    align-items:center;justify-content:center;
    border-radius:50%;
    border:1px solid rgba(255,255,255,.16);
    transition:transform .25s ease,background .25s ease,border-color .25s ease;
  }
  .socials a svg,
  .footer-socials a svg,
  a.social-link svg{width:18px;height:18px;display:block}
  .socials a:hover,
  .footer-socials a:hover,
  a.social-link:hover{transform:translateY(-3px);border-color:rgba(85,213,223,.55)}
</style>





<style id="social-image-files">
  .social-icon-img{
    width:22px;
    height:22px;
    object-fit:contain;
    display:block;
  }
</style>


<style id="journey-social-polish-v2">
  /* --- SOCIAL BUTTONS: use the actual PNGs clearly --- */
  .quick-book{
    gap:10px;
    right:20px;
    bottom:20px;
  }

  .quick-book-main,
  .quick-book-mini{
    width:56px !important;
    min-width:56px !important;
    height:56px !important;
    min-height:56px !important;
    padding:0 !important;
    display:flex !important;
    align-items:center !important;
    justify-content:center !important;
    overflow:visible !important;
    border-radius:50% !important;
    background:#fff !important;
    border:1px solid rgba(16,19,28,.09) !important;
    box-shadow:0 14px 38px rgba(16,19,28,.13) !important;
  }

  .quick-book-main:hover,
  .quick-book-mini:hover{
    transform:translateY(-4px) scale(1.035);
    box-shadow:0 18px 46px rgba(16,19,28,.17) !important;
  }

  .quick-book .social-icon-img,
  .mobile-book-dock .social-icon-img,
  .contact-choice-row .social-icon-img,
  .nav-actions .social-icon-img{
    position:relative;
    z-index:5;
    width:30px !important;
    height:30px !important;
    max-width:30px !important;
    max-height:30px !important;
    object-fit:contain !important;
    display:block !important;
    opacity:1 !important;
    visibility:visible !important;
    filter:none !important;
  }

  .nav-actions .btn:has(.social-icon-img),
  .contact-choice-row .btn:has(.social-icon-img){
    min-width:48px;
    padding:0 13px;
  }

  .mobile-book-dock a:has(.social-icon-img){
    display:flex;
    align-items:center;
    justify-content:center;
  }

  /* Prevent the generic button sheen from covering icon-only buttons. */
  .btn:has(.social-icon-img)::after{
    display:none !important;
  }

  /* --- JOURNEY: tighter, more balanced, less empty space --- */
  .journey-section{
    --journey-progress:0;
    padding:78px 0 !important;
    min-height:0 !important;
    overflow:hidden;
  }

  .journey-grid{
    grid-template-columns:minmax(300px,.82fr) minmax(520px,1.18fr) !important;
    gap:48px !important;
    align-items:center !important;
  }

  .journey-copy{
    position:relative !important;
    top:auto !important;
    align-self:center;
    max-width:480px;
  }

  .journey-copy h2{
    max-width:470px;
    margin:11px 0 15px;
    font-size:clamp(46px,4.8vw,70px) !important;
    line-height:.94 !important;
  }

  .journey-copy .body{
    max-width:455px;
    font-size:13px;
    line-height:1.72;
  }

  .journey-copy .btn{
    margin-top:0;
  }

  .journey-steps{
    gap:10px !important;
    padding-left:30px !important;
  }

  .journey-track{
    left:8px !important;
    top:24px !important;
    bottom:24px !important;
    width:2px !important;
    background:rgba(16,19,28,.07) !important;
  }

  .journey-track i{
    transition:transform .18s linear !important;
  }

  .journey-step{
    min-height:0 !important;
    padding:17px 20px !important;
    border-radius:19px !important;
    box-shadow:0 10px 34px rgba(31,43,55,.045) !important;
    transition:
      transform .62s cubic-bezier(.22,.75,.18,1),
      border-color .62s ease,
      box-shadow .62s ease,
      background .62s ease !important;
  }

  .journey-step::before{
    left:-28px !important;
    top:22px !important;
    width:12px !important;
    height:12px !important;
    transition:
      background .55s ease,
      box-shadow .55s ease,
      transform .55s ease !important;
  }

  .journey-step.is-active{
    transform:translateX(5px) !important;
    background:rgba(255,255,255,.97) !important;
    box-shadow:0 14px 40px rgba(244,49,203,.055) !important;
  }

  .journey-step.is-active::before{
    transform:scale(1.05);
  }

  .journey-step small{
    font-size:8px !important;
  }

  .journey-step h3{
    margin:5px 0 5px !important;
    font-size:18px !important;
  }

  .journey-step p{
    font-size:10.5px !important;
    line-height:1.55 !important;
  }

  /* Softer background orbs so the section looks intentional, not washed out. */
  .journey-section::before{
    content:"";
    position:absolute;
    width:360px;
    height:360px;
    left:-180px;
    top:15%;
    border-radius:50%;
    background:rgba(244,49,203,.045);
    filter:blur(18px);
    pointer-events:none;
  }

  .journey-section::after{
    content:"";
    position:absolute;
    width:420px;
    height:420px;
    right:-220px;
    bottom:0;
    border-radius:50%;
    background:rgba(85,213,223,.055);
    filter:blur(18px);
    pointer-events:none;
  }

  @media(max-width:1050px){
    .journey-grid{
      grid-template-columns:.9fr 1.1fr !important;
      gap:34px !important;
    }
    .journey-copy h2{
      font-size:clamp(42px,5.4vw,60px) !important;
    }
  }

  @media(max-width:820px){
    .journey-section{
      padding:68px 0 !important;
    }
    .journey-grid{
      grid-template-columns:1fr !important;
      gap:34px !important;
    }
    .journey-copy{
      max-width:650px;
    }
    .journey-copy h2{
      max-width:650px;
    }
    .journey-steps{
      padding-left:27px !important;
    }
  }

  @media(max-width:720px){
    .quick-book{
      display:none !important;
    }
    .mobile-book-dock .social-icon-img{
      width:25px !important;
      height:25px !important;
    }
    .journey-section{
      padding:58px 0 !important;
    }
    .journey-step{
      padding:16px 17px !important;
    }
  }
</style>


<style id="refined-layout-v3">
  /* NAV: only the pill is glassy; no full-width bar behind it */
  .header{
    background:transparent !important;
    box-shadow:none !important;
    border:0 !important;
    backdrop-filter:none !important;
    -webkit-backdrop-filter:none !important;
  }
  .nav{
    background:rgba(255,255,255,.78) !important;
    -webkit-backdrop-filter:blur(18px) saturate(140%) !important;
    backdrop-filter:blur(18px) saturate(140%) !important;
    border:1px solid rgba(255,255,255,.68) !important;
    box-shadow:0 12px 34px rgba(16,19,28,.08) !important;
  }
  .header.scrolled .nav{
    background:rgba(255,255,255,.86) !important;
    border-color:rgba(16,19,28,.08) !important;
  }

  /* SOCIAL CTAs: use word + icon when there is room; icon only for compact/floating buttons */
  .social-word-btn{
    display:inline-flex !important;
    align-items:center !important;
    gap:8px !important;
    min-height:44px !important;
    padding:0 16px !important;
    border-radius:999px !important;
    background:#fff !important;
    border:1px solid var(--line) !important;
    color:var(--ink) !important;
    box-shadow:none !important;
  }
  .social-word-btn:hover{
    transform:translateY(-2px);
    border-color:rgba(244,49,203,.22) !important;
  }
  .social-word-btn .social-icon-img{
    width:20px !important;
    height:20px !important;
    object-fit:contain !important;
  }
  .social-word-btn .social-label{
    font-size:11px;
    font-weight:700;
  }

  /* Floating/compact icons: no pink circle background */
  .quick-book-main,
  .quick-book-mini,
  .social-icon-only{
    width:44px !important;
    min-width:44px !important;
    height:44px !important;
    min-height:44px !important;
    padding:0 !important;
    background:rgba(255,255,255,.9) !important;
    border:1px solid rgba(16,19,28,.08) !important;
    box-shadow:0 10px 28px rgba(16,19,28,.10) !important;
    border-radius:50% !important;
  }
  .quick-book-main .social-icon-img,
  .quick-book-mini .social-icon-img,
  .social-icon-only .social-icon-img{
    width:24px !important;
    height:24px !important;
  }

  /* ENQUIRY: remove stacked repetition / empty box feeling */
  .enquiry-section{
    padding:82px 0 !important;
  }
  .enquiry-heading{
    max-width:760px !important;
    margin-bottom:24px !important;
  }
  .enquiry-heading .privacy-note{
    margin-top:14px !important;
    padding:12px 14px !important;
  }
  .official-form-card{
    border-radius:24px !important;
    box-shadow:0 18px 52px rgba(31,24,40,.07) !important;
  }
  .official-form-top{
    padding:18px 20px !important;
    gap:16px !important;
  }
  .official-form-top strong{
    font-size:17px !important;
  }
  .official-form-top span{
    font-size:10px !important;
  }
  .official-form-frame{
    min-height:0 !important;
  }
  .official-form-frame iframe{
    min-height:680px !important;
    height:72vh !important;
  }
  .embed-consent{
    min-height:220px !important;
    padding:30px 22px !important;
  }
  .embed-consent-inner{
    max-width:470px !important;
  }
  .embed-consent p{
    margin:8px 0 14px !important;
  }
  .form-fallback{
    padding:12px 16px !important;
  }
  .enquiry-alt{
    margin-top:12px !important;
    padding:14px 16px !important;
  }

  /* If optional content is blocked, don't reserve a huge blank iframe area */
  iframe[hidden]{
    display:none !important;
  }

  /* JOURNEY: minimal, dense, useful */
  .journey-section{
    padding:64px 0 !important;
  }
  .journey-grid{
    grid-template-columns:minmax(300px,.78fr) minmax(520px,1.22fr) !important;
    gap:34px !important;
    align-items:center !important;
  }
  .journey-copy{
    max-width:420px !important;
  }
  .journey-copy h2{
    max-width:420px !important;
    font-size:clamp(42px,4.2vw,62px) !important;
    margin:10px 0 12px !important;
  }
  .journey-copy .body{
    max-width:400px !important;
    font-size:12.5px !important;
    line-height:1.66 !important;
  }
  .journey-steps{
    gap:8px !important;
    padding-left:26px !important;
  }
  .journey-step{
    padding:14px 17px !important;
    border-radius:17px !important;
  }
  .journey-step h3{
    font-size:17px !important;
    margin:4px 0 !important;
  }
  .journey-step p{
    font-size:10px !important;
    line-height:1.5 !important;
  }
  .journey-step::before{
    top:18px !important;
  }

  /* Keep buttons visually filled only when they need to be */
  .btn{
    box-shadow:none;
  }
  .btn-pink{
    box-shadow:0 10px 24px rgba(244,49,203,.18);
  }

  @media(max-width:900px){
    .journey-grid{
      grid-template-columns:1fr !important;
      gap:28px !important;
    }
    .journey-copy,.journey-copy h2,.journey-copy .body{
      max-width:650px !important;
    }
  }

  @media(max-width:720px){
    .nav{
      background:rgba(255,255,255,.86) !important;
    }
    .social-word-btn .social-label{
      display:none;
    }
    .social-word-btn{
      width:44px !important;
      min-width:44px !important;
      padding:0 !important;
      justify-content:center !important;
    }
    .enquiry-section{
      padding:62px 0 !important;
    }
    .official-form-top{
      grid-template-columns:1fr !important;
    }
    .official-form-top .btn{
      width:auto !important;
      justify-self:start;
    }
  }
</style>


<style id="final-functional-polish">
  /* Hidden consent overlays must REALLY disappear once accepted.
     .embed-consent uses display:flex, which otherwise overrides the HTML hidden attribute. */
  [data-embed-placeholder][hidden],
  .embed-consent[hidden],
  iframe[data-consent-src][hidden]{
    display:none !important;
  }

  /* Only the pill navbar is transparent/glassy. */
  .header{
    background:transparent !important;
    box-shadow:none !important;
    backdrop-filter:none !important;
    -webkit-backdrop-filter:none !important;
  }
  .nav{
    background:rgba(255,255,255,.64) !important;
    border-color:rgba(255,255,255,.58) !important;
    -webkit-backdrop-filter:blur(20px) saturate(145%) !important;
    backdrop-filter:blur(20px) saturate(145%) !important;
    box-shadow:0 10px 30px rgba(16,19,28,.07) !important;
  }
  .header.scrolled .nav{
    background:rgba(255,255,255,.72) !important;
    border-color:rgba(255,255,255,.62) !important;
  }

  /* Parent Portal: restrained pink glow on hover */
  .portal-link{
    position:relative;
    border-radius:999px;
    transition:
      color .28s ease,
      background .28s ease,
      box-shadow .28s ease,
      transform .28s ease !important;
  }
  .portal-link:hover,
  .portal-link:focus-visible{
    color:var(--pink-deep) !important;
    background:rgba(244,49,203,.075) !important;
    box-shadow:
      0 0 0 1px rgba(244,49,203,.11),
      0 8px 24px rgba(244,49,203,.16),
      0 0 24px rgba(244,49,203,.12) !important;
    transform:translateY(-1px);
    outline:none;
  }

  /* The form placeholder is compact while consent is still required. */
  .official-form-frame:has(.embed-consent:not([hidden])){
    min-height:0 !important;
  }
  .official-form-frame:has(.embed-consent:not([hidden])) .embed-consent{
    min-height:210px !important;
  }

  /* Once accepted, let the real form fill the card cleanly. */
  .official-form-frame iframe:not([hidden]){
    display:block !important;
    width:100% !important;
    min-height:720px !important;
    height:78vh !important;
    max-height:980px !important;
  }

  @media(max-width:720px){
    .nav{
      background:rgba(255,255,255,.74) !important;
    }
    .official-form-frame iframe:not([hidden]){
      min-height:680px !important;
      height:78vh !important;
    }
  }
</style>


<style id="caventro-footer-credit">
  .footer-bottom{
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:24px;
  }

  .footer-bottom-left{
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    gap:5px;
  }

  .caventro-credit{
    position:relative;
    display:inline-flex;
    align-items:center;
    color:rgba(255,255,255,.48);
    font-size:9px;
    font-weight:600;
    letter-spacing:.02em;
    text-decoration:none;
    transition:
      color .25s ease,
      opacity .25s ease,
      transform .25s ease;
  }

  .caventro-credit::after{
    content:"";
    position:absolute;
    left:0;
    bottom:-2px;
    width:100%;
    height:1px;
    background:var(--aqua);
    transform:scaleX(0);
    transform-origin:left;
    transition:transform .25s ease;
  }

  .caventro-credit:hover{
    color:var(--aqua);
    transform:translateY(-1px);
  }

  .caventro-credit:hover::after{
    transform:scaleX(1);
  }

  .footer-legal-links{
    display:flex;
    align-items:center;
    justify-content:flex-end;
    flex-wrap:wrap;
    gap:12px;
  }

  .footer-legal-links a,
  .footer-legal-links button{
    color:inherit;
    font:inherit;
    font-size:9px;
    background:none;
    border:0;
    padding:0;
    cursor:pointer;
    transition:color .2s ease;
  }

  .footer-legal-links a:hover,
  .footer-legal-links button:hover{
    color:#fff;
  }

  @media(max-width:720px){
    .footer-bottom{
      flex-direction:column;
      align-items:flex-start;
      gap:16px;
    }

    .footer-bottom-left{
      width:100%;
    }

    .footer-legal-links{
      justify-content:flex-start;
    }
  }
</style>

</head>

