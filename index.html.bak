  <script>
    (function(){
      const root = document.documentElement;
      const header = document.getElementById('header');
      const heroImage = document.getElementById('heroImage');
      const thermoStage = document.getElementById('temperatureStage');
      const journeyStage = document.getElementById('journeyStage');
      const portalSection = document.getElementById('portal');
      const qualificationsSection = document.getElementById('qualifications');
      const floatEls = document.querySelectorAll('[data-scroll-float]');
      
      const menuBtn = document.getElementById('menuBtn');
      const mobileMenu = document.getElementById('mobileMenu');

      // Scroll-linked water movement + subtle image parallax.
      function onScroll(){
        const y = window.scrollY || 0;
        root.style.setProperty('--water-shift', (y * .075) + 'px');
        header.classList.toggle('scrolled', y > 30);

        const doc = document.documentElement;
        const maxScroll = Math.max(1, doc.scrollHeight - window.innerHeight);
        root.style.setProperty('--page-progress', Math.max(0, Math.min(1, y / maxScroll)).toFixed(4));

        floatEls.forEach(el => {
          const r = el.getBoundingClientRect();
          const vh = window.innerHeight || 800;
          const centre = r.top + r.height * .5;
          const delta = (centre - vh * .5) / vh;
          const depth = parseFloat(el.dataset.depth || '.03');
          const offset = Math.max(-24, Math.min(24, delta * -180 * depth * 10));
          const rot = Math.max(-1.4, Math.min(1.4, delta * depth * 9));
          el.style.setProperty('--float-y', offset.toFixed(2) + 'px');
          el.style.setProperty('--float-rotate', rot.toFixed(2) + 'deg');
        });

        if(qualificationsSection){
          const qr = qualificationsSection.getBoundingClientRect();
          const qh = qualificationsSection.offsetHeight || 1;
          const qp = Math.max(0, Math.min(1, (window.innerHeight - qr.top) / (window.innerHeight + qh * .45)));
          qualificationsSection.style.setProperty('--qual-progress', qp.toFixed(3));
        }

        if(journeyStage){
          const jr = journeyStage.getBoundingClientRect();
          const vh = window.innerHeight || 800;
          // Intentionally broad scroll range so the journey progresses calmly.
          // It starts only after the section has entered the lower viewport and
          // does not finish until most of the journey has passed through.
          const startLine = vh * .88;
          const travel = Math.max(vh * 1.65, jr.height + vh * .95);
          let jp = (startLine - jr.top) / travel;
          jp = Math.max(0, Math.min(1, jp));
          journeyStage.closest('.journey-section').style.setProperty('--journey-progress', jp.toFixed(3));

          const steps = journeyStage.querySelectorAll('.journey-step');
          const activeIndex = Math.min(steps.length - 1, Math.max(0, Math.floor(jp * steps.length)));
          steps.forEach((step, i) => {
            step.classList.toggle('is-active', i === activeIndex && jp > .02);
          });
        }

        if(portalSection){
          const pr = portalSection.getBoundingClientRect();
          const vh = window.innerHeight || 800;
          let pp = (vh * .85 - pr.top) / (vh * .58);
          pp = Math.max(.12, Math.min(1, pp));
          root.style.setProperty('--portal-progress', pp.toFixed(3));
        }
        

        // Thermometer animation tied directly to scroll position through its section.
        if(thermoStage){
          const r = thermoStage.getBoundingClientRect();
          const vh = window.innerHeight || 800;
          const start = vh * .88;
          const end = vh * .28;
          let p = (start - r.top) / (start - end);
          p = Math.max(0, Math.min(1, p));
          root.style.setProperty('--thermo-progress', p.toFixed(3));
        }
      }
      window.addEventListener('scroll', onScroll, {passive:true});
      window.addEventListener('resize', onScroll);
      onScroll();

      // Reveal sections and water-clipped images.
      const reveals = document.querySelectorAll('.reveal,.reveal-left,.reveal-right');
      if('IntersectionObserver' in window){
        const io = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if(entry.isIntersecting){
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          });
        }, {threshold:.10});
        reveals.forEach(el => io.observe(el));
      } else {
        reveals.forEach(el => el.classList.add('in'));
      }

      [
        '.trust-grid .trust',
        '.qual-grid .qual',
        '.credential-logos > *',
        '.journey-steps .journey-step',
        '.benefits .benefit',
        '.portal-mini-grid .portal-mini'
      ].forEach(selector => {
        document.querySelectorAll(selector).forEach((el, i) => {
          el.style.setProperty('--reveal-delay', Math.min(i * 75, 320) + 'ms');
        });
      });

      // FAQ.
      document.querySelectorAll('.faq-q').forEach(q => {
        q.addEventListener('click', () => q.closest('.faq-item').classList.toggle('open'));
      });

      // Mobile menu.
      if(menuBtn && mobileMenu){
        menuBtn.addEventListener('click', () => {
          const open = mobileMenu.style.display !== 'none';
          mobileMenu.style.display = open ? 'none' : 'block';
          menuBtn.setAttribute('aria-expanded', open ? 'false' : 'true');
        });
        mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
          mobileMenu.style.display = 'none';
          menuBtn.setAttribute('aria-expanded','false');
        }));
      }
    })();
  </script>

  <script id="whatsapp-message-builder">
    (function(){
      const send = document.getElementById('waSend');
      if(!send) return;

      send.addEventListener('click', function(){
        const name = (document.getElementById('waName').value || '').trim();
        const lesson = document.getElementById('waLesson').value;
        const extra = (document.getElementById('waMessage').value || '').trim();

        let message = 'Hi Swimtrain, ';
        if(name) message += "I'm " + name + ". ";
        message += "I'm interested in " + lesson + " and wanted to ask about the current options, availability and prices.";
        if(extra) message += "\\n\\n" + extra;

        window.open('https://wa.me/447364123477?text=' + encodeURIComponent(message), '_blank', 'noopener');
      });
    })();
  </script>


  <div class="cookie-banner" id="cookieBanner" role="dialog" aria-live="polite" aria-label="Cookie choices">
    <div class="cookie-copy">
      <strong>Your privacy choices</strong>
      <p>Swimtrain uses essential browser storage to remember your privacy choice. Optional third-party content, including the iSplash enquiry form and Google Maps, is not loaded unless you choose to allow it. Read the <a href="cookie-policy.html">Cookie Policy</a>.</p>
    </div>
    <div class="cookie-actions">
      <button class="cookie-btn" type="button" id="rejectOptional">Reject optional</button>
      <button class="cookie-btn primary" type="button" id="acceptOptional">Accept optional</button>
    </div>
  </div>

  <script id="swimtrain-cookie-consent">
    (function(){
      const KEY = 'swimtrainPrivacyChoice';
      const banner = document.getElementById('cookieBanner');
      const accept = document.getElementById('acceptOptional');
      const reject = document.getElementById('rejectOptional');

      function getChoice(){
        try { return localStorage.getItem(KEY); } catch(e) { return null; }
      }

      function saveChoice(value){
        try { localStorage.setItem(KEY, value); } catch(e) {}
      }

      function loadOptionalEmbeds(){
        document.querySelectorAll('iframe[data-consent-src]').forEach(function(frame){
          if(!frame.getAttribute('src')){
            frame.setAttribute('src', frame.getAttribute('data-consent-src'));
          }
          frame.hidden = false;
        });
        document.querySelectorAll('[data-embed-placeholder]').forEach(function(el){
          el.hidden = true;
        });
      }

      function blockOptionalEmbeds(){
        document.querySelectorAll('iframe[data-consent-src]').forEach(function(frame){
          frame.removeAttribute('src');
          frame.hidden = true;
        });
        document.querySelectorAll('[data-embed-placeholder]').forEach(function(el){
          el.hidden = false;
        });
      }

      function applyChoice(choice){
        if(choice === 'optional-accepted'){
          loadOptionalEmbeds();
        } else {
          blockOptionalEmbeds();
        }
        if(banner) banner.classList.remove('show');
      }

      function showSettings(){
        if(banner) banner.classList.add('show');
      }

      const existing = getChoice();
      if(existing){
        applyChoice(existing);
      } else {
        blockOptionalEmbeds();
        if(banner) banner.classList.add('show');
      }

      if(accept) accept.addEventListener('click', function(){
        saveChoice('optional-accepted');
        applyChoice('optional-accepted');
      });

      if(reject) reject.addEventListener('click', function(){
        saveChoice('optional-rejected');
        applyChoice('optional-rejected');
      });

      document.querySelectorAll('[data-accept-optional]').forEach(function(btn){
        btn.addEventListener('click', function(){
          saveChoice('optional-accepted');
          applyChoice('optional-accepted');

          // If this button belongs to an embed placeholder, reveal that embed
          // immediately and move it gently into view so the action feels responsive.
          const placeholder = btn.closest('[data-embed-placeholder]');
          if(placeholder){
            const frame = placeholder.parentElement
              ? placeholder.parentElement.querySelector('iframe[data-consent-src]')
              : null;
            if(frame){
              window.setTimeout(function(){
                frame.scrollIntoView({behavior:'smooth', block:'nearest'});
              }, 80);
            }
          }
        });
      });

      document.querySelectorAll('[data-open-cookie-settings]').forEach(function(btn){
        btn.addEventListener('click', showSettings);
      });
    })();
  </script>


<script id="embed-load-feedback">
  document.addEventListener('click', function(e){
    const btn = e.target.closest('[data-accept-optional]');
    if(!btn) return;
    const original = btn.textContent;
    btn.textContent = 'Loading…';
    btn.setAttribute('aria-busy','true');
    window.setTimeout(function(){
      btn.removeAttribute('aria-busy');
      btn.textContent = original;
    }, 500);
  });
</script>

</body>
</html>
